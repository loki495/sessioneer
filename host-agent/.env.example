# Copy to .env and fill in the values that need it for your machine. Never
# commit .env.
#
# Loaded by systemd via EnvironmentFile= in sessioneer-agent@.service. Most
# variables below are optional - if unset (or this file is missing
# entirely), host-agent/lib/Services/Config.php falls back to a value
# derived from this process's own environment (real $HOME, real uid, this
# repo's own real checkout path), never a hardcoded path from any one
# specific machine. Set the *_BIN variable for every agent you plan to
# manage. If you're enabling Web Push, its VAPID values are required too.
#
# tests/.env.testing is the analogous file for the test suite - it points
# every variable below at an isolated tmux socket and a fixture claude
# binary instead of your real session. See tests/run.sh.

# --- Root this agent resolves its own paths (quota_live_state_write.php,
# the default PUSH_SQLITE_FILE, etc.) from. Defaults to this repo's own
# checkout path, derived automatically - only needed if the agent is
# somehow running from a different location than its own checkout. ---
#SESSIONEER_REPO_ROOT=

# --- Required only when managing Claude Code: the real claude CLI binary.
# argv[0] must match this exactly
# (see find_claude_processes() in host-agent/lib/Services/ProcessInspector.php) -
# run `which claude` to find it. ---
CLAUDE_BIN=

# --- Only needed if you're using Antigravity CLI support: the real `agy`
# binary - run `which agy` to find it. Unlike CLAUDE_BIN, not required for
# a Claude-Code-only setup. ---
#ANTIGRAVITY_BIN=

# --- Only needed if you're using OpenCode TUI support: the real `opencode`
# binary - run `which opencode` to find it. Unlike CLAUDE_BIN, not required
# for a Claude-Code-only setup. ---
#OPENCODE_BIN=

# --- The OpenCode server this agent talks to (started separately, e.g.
# `opencode serve`). Defaults to http://localhost:4096, OpenCode's own
# default. ---
#OPENCODE_SERVE_URL=

# --- OpenCode's own session database and auth file - only need overriding
# if you've pointed OpenCode itself at a non-default XDG data dir. Default
# to ~/.local/share/opencode/opencode.db and .../auth.json. ---
#OPENCODE_DB_PATH=
#OPENCODE_AUTH_PATH=

# --- Where this agent writes OpenCode permission-request state it's
# tracking. Defaults under SIDECAR_DIR (below). ---
#OPENCODE_PERMISSION_DIR=

# --- Native Codex headless support. Sessioneer starts a private `codex
# app-server` behind a persistent local bridge; Codex sessions never use tmux.
# For Codex Remote interoperability, separately bootstrap the managed daemon
# with `codex app-server daemon bootstrap --remote-control`; materialized
# threads are written through `codex queue`, while this bridge owns
# Sessioneer-created prompts. Install/trust ~/.codex/hooks.json as described in
# README.md so Remote-owned activity and input blocks are observable.
# Run `which codex`. The bridge socket defaults to
# /run/user/<uid>/sessioneer-codex-bridge.sock. ---
#CODEX_BIN=
#CODEX_BRIDGE_SOCKET=

# --- Headless Claude Code sessions (no tmux pane): a persistent manager owns
# one `claude -p` stream-json process per ACTIVE session, authenticated by your
# own claude.ai login (the manager strips ANTHROPIC_API_KEY/ANTHROPIC_AUTH_TOKEN
# from those processes and refuses to run one that reports an API-key source).
# Requires CLAUDE_BIN (above). All optional:
# - CLAUDE_HEADLESS_SOCKET: defaults to /run/user/<uid>/sessioneer-claude-headless.sock
# - CLAUDE_HEADLESS_IDLE_SECONDS: an idle session's process is stopped after
#   this long and resumed on the next message. Default 1800; 0 = never.
# - CLAUDE_HEADLESS_MAX_CHILDREN: most concurrent Claude processes. Default 8
#   (each idle process holds roughly 600 MB).
# - CLAUDE_HEADLESS_STOP_GRACE_SECONDS: how long a stopping process gets to
#   exit before SIGTERM. Default 10.
# - CLAUDE_HEADLESS_UNIT_NAME: the systemd user unit the health box checks.
#   Default sessioneer-claude-headless-manager.service.
# - SESSIONEER_DEBUG=1: re-throw unexpected errors in long-lived services
#   instead of handling them into a generic failure (local development). ---
#CLAUDE_HEADLESS_SOCKET=
#CLAUDE_HEADLESS_IDLE_SECONDS=1800
#CLAUDE_HEADLESS_MAX_CHILDREN=8
#CLAUDE_HEADLESS_STOP_GRACE_SECONDS=10
#CLAUDE_HEADLESS_UNIT_NAME=
#SESSIONEER_DEBUG=

# --- Minimum interval between headless OpenCode syncs/status polls. Defaults
# to 15 seconds. Set to 0 to run the sync on every request (mainly useful for
# testing; the dashboard itself still polls at its separate UI interval). ---
#HEADLESS_SYNC_SECONDS=15

# --- Root directory offered as "workdir" choices in the New Session form.
# Defaults to HOME_ROOT (below) if unset - set this to wherever your
# projects actually live if that's not directly under your home directory. ---
#WWW_ROOT=

# --- Upper bound for the New Session folder browser - browsing can never
# go above this directory, even though WWW_ROOT is where it starts.
# Defaults to your real $HOME. ---
#HOME_ROOT=

# --- tmux socket this agent drives (-S flag). Defaults to
# /tmp/tmux-<your-uid>/default - tmux's own real default socket path, the
# same one a plain `tmux` command with no -S/-L lands on. ---
#TMUX_SOCKET=

# --- Where per-session sidecar metadata (workdir, spawned_at) is stored.
# Defaults to /run/user/<your-uid>/sessioneer-sessions. ---
#SIDECAR_DIR=

# --- Where the very-short-lived session-list cache (see
# SessionListCacheStore) is stored. Defaults to /run/user/<your-uid>/
# sessioneer-cache - deliberately NOT SIDECAR_DIR, whose contents get
# globbed and pruned as orphans. ---
#CACHE_DIR=

# --- The two SQLite DB files backing everything under "Per-session/global
# state storage" in CONTRIBUTING.md. SESSIONS_SQLITE_FILE defaults under
# SIDECAR_DIR (tmpfs, wiped on reboot - tied to sessions that don't
# survive one either); PUSH_SQLITE_FILE defaults to
# host-agent/state/push.sqlite under this repo's own checkout (persisted,
# gitignored - a phone's push subscription shouldn't need to be redone
# just because the host restarted). ---
#SESSIONS_SQLITE_FILE=
#PUSH_SQLITE_FILE=

# --- How long (seconds, fractional allowed) a session-list scan (a tmux
# capture-pane per tracked session plus a /proc walk - the single most
# expensive thing this agent does) is reused across near-simultaneous
# callers: multiple open tabs, or a session page's own poll timer landing
# close to the dashboard's. Kept below the fastest selectable poll
# interval (1s - see POLL_INTERVAL_ALLOWED_MS in common.js) so a single
# poller always gets a fresh scan on every one of its own ticks; this only
# ever coalesces concurrent callers, never delays a lone poller past what
# it already asked for. ---
SESSION_LIST_CACHE_TTL_SECONDS=0.9

# --- How long Take over waits for a stopped bare process to actually exit
# before resuming its conversation (a real Claude can take seconds to shut
# down after SIGTERM/SIGHUP). Still running at the deadline: the conversation
# is left for the Archived list rather than opening a second writer on its
# transcript. ---
TAKE_OVER_EXIT_WAIT_SECONDS=15

# --- Seconds of inactivity before "Kill inactive" considers a session dead ---
CLEANUP_THRESHOLD_SECONDS=43200

# --- Initial tmux pane size for a newly created session (-x/-y on
# new-session). No real client is ever attached to inherit a size from, so
# without this it falls back to tmux's own 80x24 default - nowhere near
# enough for Claude Code's own TUI to render a long tool-permission
# preview (a big Write, a long Bash script) without cutting it short.
# Only affects sessions created AFTER this is set - existing ones stay at
# whatever size they were created with. ---
TMUX_PANE_WIDTH=200
TMUX_PANE_HEIGHT=150

# --- The statusLine script this app installs (see the README's "Usage
# quota footer" section, StatuslineMarkerService) writes account-wide
# rate-limit quota to the quota_live_state row in push.sqlite's
# global_state table on every status-line render - event-driven, no tmux
# involved, no separate file/env var to configure. The only source the
# "quota" action reads from (a live tmux-pane scan, and an external
# claude-quota-binary scrape behind that, were both deleted 2026-08-22 as
# dead code - once this row has been written once, neither fallback could
# ever actually be reached). ---

# --- Web Push notifications (see the README's "Web Push notifications"
# section for the one-time setup). Both keys empty/unset (the default on
# a fresh checkout) means push_configured() in lib/Push.php returns false
# and every push-related action - the systemd timer's check, the
# subscribe endpoint - is a harmless no-op. Generate a real pair with:
#   php -r "require 'vendor/autoload.php'; print_r(Minishlink\WebPush\VAPID::createVapidKeys());"
# ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- REQUIRED if you set the VAPID keys above: the Web Push spec itself
# requires a contact point the push service can reach you at - any
# mailto: address or https: URL works. ---
VAPID_SUBJECT=

# --- Subscribed devices, session-transition state (for the push-check
# timer's blocked/finished notifications), and quota-push state (below)
# all live in PUSH_SQLITE_FILE's own tables (see the README's "State
# storage" section) - persisted, gitignored, deliberately NOT under
# /run/user/<uid> like the sidecar/session-cache paths above, since a
# phone's push subscription shouldn't need to be redone just because the
# host restarted. Nothing to configure here individually. ---

# --- How long (seconds) a session must have been continuously working
# before finishing counts as worth a "finished, no input needed"
# notification - avoids notifying for every trivial quick reply. ---
PUSH_MIN_WORKING_SECONDS_FOR_FINISH_NOTIFY=60

# --- Quota near/over/reset push notifications - a separate pass from the
# session-transition one above, run in the same push_trigger.php tick.
# Set to 0 to turn OFF just this pass (session-blocked/finished
# notifications keep working) without touching VAPID keys at all - takes
# effect on the very next timer tick, no restart needed (push_trigger.php
# is a Type=oneshot service re-spawned fresh every tick, so systemd
# re-reads this whole file each time). ---
PUSH_QUOTA_NOTIFICATIONS_ENABLED=1

# --- A quota bucket's pct at or above this is "close to over" - its own
# notification, separate from reaching 100% ("over"). ---
PUSH_QUOTA_NEAR_THRESHOLD_PCT=90

# --- Each quota bucket's last-known pct/resets_at, and whether a
# near/over/reset notification has already fired for the current window,
# plus a separate heartbeat for this pass so it can't clobber the
# session-transition pass's own status in the dashboard health box - both
# in PUSH_SQLITE_FILE's tables (PushQuotaStateStore), same one-shot-per-
# crossing idea as the session-transition state above. "Reset" fires once
# wall-clock time passes a bucket's own resets_at (a real Unix epoch from
# Claude Code's own statusLine JSON), not from a pct comparison - see
# PushDeliveryService::check_and_send_quota_pushes()'s own docblock for
# why. ---
