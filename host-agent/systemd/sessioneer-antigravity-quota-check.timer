[Unit]
Description=Periodically poll Antigravity's own account-wide quota (agy -p "/usage")

[Timer]
# 60s (Andres's own ask, 2026-08-24): confirmed live this call is free
# (duration_seconds=0, zero token usage, no real model turn - see
# docs/history/antigravity-adapter-plan.md's quota research), so there's no cost
# pressure to poll less often. Quota itself only changes on real tool/model
# usage elsewhere, so once a minute is already generous relative to how
# fast the underlying number actually moves.
# OnUnitActiveSec (not OnCalendar) so a slow tick (an overloaded host)
# can't pile up overlapping runs - same reasoning sessioneer-push-check.timer
# already uses.
OnBootSec=60s
OnUnitActiveSec=60s
Unit=sessioneer-antigravity-quota-check.service

[Install]
WantedBy=timers.target
