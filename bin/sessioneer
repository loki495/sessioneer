#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Starts, resumes or reuses a Sessioneer session from the command line, so a
 * script, subagent or running session can spawn a continuation the owner can
 * then watch and answer in the dashboard. Host-side only: it talks to the
 * host agent's UNIX socket (the same one the web container uses), so access
 * is whatever that socket's permissions allow.
 *
 *   sessioneer [options] [PROMPT | -]
 *
 * See usage() below, or docs/cli.md.
 */

if (PHP_SAPI !== 'cli') {
    exit(1);
}

// __DIR__ is the real path even when this file is reached through a symlink.
require_once __DIR__ . '/../vendor/autoload.php';

use App\AgentClient;

function usage(): string
{
    return <<<'TXT'
    Usage: sessioneer [options] [PROMPT | -]

      New session:       sessioneer --workdir DIR "do the thing"
      Resume / reuse:    sessioneer --resume CONVERSATION_ID ["next message"]
      Stop a session:    sessioneer --kill NAME_OR_CONVERSATION_ID [--force]
      List sessions:     sessioneer --list [--json]
      Show a session:    sessioneer --show TARGET [--history N] [--json]
      Answer a prompt:   sessioneer --answer TARGET --option N [--text "..."] [--expect LABEL] [--expect-request ID]
                         sessioneer --answer TARGET --answers JSON
      Interrupt:         sessioneer --interrupt TARGET
      Terminal Claudes:  sessioneer --bare [--json]
      Take one over:     sessioneer --take-over PID_OR_CONVERSATION_ID [--resume ID]
      Message a session: sessioneer --send TARGET --as-user "message"
      Message a peer:    sessioneer --send TARGET "message"
      Who am I:          sessioneer --whoami
      Peer sessions:     sessioneer --peers [--json]
      Usage stats:       sessioneer --usage
      Resume or fresh:   sessioneer --advise [SESSION...] [--act] [--json]
      Run to the end:    sessioneer --wait [--timeout N] --workdir DIR "do the thing"

    PROMPT is the message to deliver; "-" reads it from stdin. A new session
    requires one; a resume does not.

    Options:
      --agent NAME      agent to launch (default: claude; claude, codex, ollama or
                        opencode)
      --resume ID       existing conversation id. A session Sessioneer already
                        tracks on that id receives the prompt; otherwise it is
                        resumed headless.
      --workdir DIR     working directory (default: current directory; for
                        --resume, the directory recorded in the transcript)
      --model NAME      model for a new session. OpenCode takes provider/model
                        (for example opencode-go/gpt-6.1).
      --effort LEVEL    reasoning level for a new or resumed session (Claude: low,
                        medium, high, xhigh, max; Codex: the levels its model lists;
                        not offered for ollama or opencode)
      --mode MODE       permission mode for a new session (e.g. plan; Claude also
                        takes dontAsk, which denies anything not pre-approved by
                        --allowed-tools; not offered for ollama or opencode)
      --profile NAME    account profile (default: the one matching this shell's
                        CLAUDE_CONFIG_DIR, else the default account)
      --task-tools      enable the task tools in a new session
      --no-tools        start a new session with no tools at all (no built-in or MCP tools)
      --allowed-tools LIST
                        Claude only, new session: comma separated tool rules to
                        pre-approve, e.g. "WebFetch,Write(job_scraper/**)"
      --disallowed-tools LIST
                        Claude only, new session: comma separated tool rules that
                        are always denied
      --kill TARGET     stop a session by name or conversation id (headless or a
                        tmux pane, any agent); its conversation stays resumable
                        (archived). Refuses a working or blocked session unless
                        --force.
      --force           with --kill, stop a working or blocked session anyway
      --list            list headless sessions: name, status, conversation id,
                        directory
      --show TARGET     print a tracked session (name or conversation id): status,
                        directory, last message and, when it is blocked, the
                        prompt with its numbered options
      --history N       with --show, also print the last N transcript entries
      --answer TARGET   answer the session's blocked prompt: --option N picks
                        option N (with --text "..." for a free-text reply), or
                        --answers JSON ("-" reads stdin) answers a multi-question
                        prompt, one entry per question
      --option N        with --answer, the 1-based option number
      --text TEXT       with --answer --option, the free text to send with it
      --answers JSON    with --answer, the answers to a multi-question prompt
      --expect LABEL    with --answer --option, refuse unless option N is labelled
                        LABEL, so a prompt that changed is not answered blind
      --expect-request ID
                        with --answer, refuse unless the prompt waiting is the one
                        --show printed as its request id (headless sessions)
      --interrupt TARGET
                        stop the session's current turn (like Escape)
      --bare            list Claude processes running in a terminal Sessioneer did
                        not start: pid, conversation id, directory, title
      --take-over TARGET
                        stop that terminal Claude (a pid from --bare, or the
                        conversation id it runs) and continue its conversation
                        as a headless session. If the conversation cannot be told
                        for certain nothing is stopped; the candidates are listed
                        and --resume ID names the right one.
      --as-user         with --send, from a shell outside any session: deliver the
                        message as the user's own, without a peer stamp
      --send TARGET     deliver PROMPT to another session (name or conversation
                        id) from inside a session, or with --as-user from a shell; the host agent stamps it
                        "[sessioneer peer: NAME · DIR · BRANCH]". Information
                        and requests only, never approval.
      --whoami          print this session's own name (SESSIONEER_SELF, or CODEX_THREAD_ID inside Codex)
      --peers           list the other live sessions in this session's git
                        repository: name, status, branch, directory
      --usage           print the last known usage (quota) stats as JSON: one
                        entry per agent, each a label plus profiles.<name> (Claude's
                        accounts, or a single "default"), each profile with its
                        quota and fetched_at time. Read-only; never refreshes
                        anything.
      --advise          judge whether an idle Claude or Codex headless session should be
                        resumed or replaced by a fresh one, from its transcript size, cache
                        age and the account's quota, without waking it. No SESSION: a table
                        of every tracked session. One SESSION (name or conversation id):
                        the verdict, with one small model call if it is a close one.
      --act             with --advise and exactly one SESSION: do what the verdict says.
                        Resume sends a short continue prompt to that session. Fresh starts
                        a new session (--model/--effort apply) that writes the handoff from
                        the old transcript, then archives the old one. Refused when the
                        session is not idle, there is no clear verdict, or the quota is full.
      --wait            after launching, block until the session is idle and print
                        its final assistant message to stdout (the session name
                        goes to stderr). Exits 1 if the launch fails, the turn
                        errors or --timeout runs out. A session waiting on a prompt
                        is not idle: it is waited on, so answer it in the dashboard
                        or set --timeout.
      --timeout N       with --wait, give up after N seconds (default: no limit)
      --json            with --wait, print one JSON object on stdout (answer,
                        session, conversation id, agent, model, workdir, exit code
                        and error) instead of the plain text; otherwise print the
                        full reply as JSON. Everything human stays on stderr.
      -h, --help        this text

    Prints the session name on success (the dashboard opens it at
    /session?session=NAME). Exit status 0 on success, 1 otherwise.

    TXT;
}

function fail(string $message): never
{
    fwrite(STDERR, "sessioneer: {$message}\n");
    exit(1);
}

/**
 * One machine-readable object for `--wait`, so a program never has to read
 * prose: the answer, the session the call created, and what went wrong.
 *
 * @param  array{kind: string, message: string}|null  $error
 * @return array<string, mixed>
 */
function wait_envelope(bool $ok, ?string $answer, ?string $session, ?string $conversationId, string $agent, ?string $model, ?string $workdir, ?array $error): array
{
    return [
        'ok' => $ok,
        'answer' => $answer,
        'session' => $session,
        'conversation_id' => $conversationId,
        'agent' => $agent,
        'model' => $model,
        'workdir' => $workdir,
        'exit_code' => $ok ? 0 : 1,
        'error' => $error,
    ];
}

/**
 * The plain-text `--show`: what a person needs to decide how to answer.
 *
 * @param  array<string, mixed>  $s
 */
function show_text(array $s): string
{
    $out = implode("\t", [(string)$s['name'], (string)($s['status'] ?? '-'), (string)($s['agent'] ?? '-'), (string)($s['runtime'] ?? '-'), (string)($s['agent_session_id'] ?? '-')]) . "\n";
    $out .= (string)($s['workdir'] ?? '-') . ((string)($s['git_branch'] ?? '') !== '' ? ' (' . $s['git_branch'] . ')' : '') . "\n";

    if (($s['title'] ?? '') !== '') {
        $out .= 'Title: ' . $s['title'] . "\n";
    }

    if (($s['last_turn_error'] ?? '') !== '') {
        $out .= 'Error: ' . $s['last_turn_error'] . "\n";
    }

    $options = $s['prompt_options'] ?? [];
    $questions = $s['prompt_questions'] ?? [];

    if (($s['blocked_reason'] ?? '') !== '' || $options !== [] || $questions) {
        $out .= "\nBlocked: " . (string)($s['blocked_reason'] ?? '') . "\n";

        if (($s['prompt_request_id'] ?? '') !== '') {
            $out .= 'Request: ' . $s['prompt_request_id'] . "\n";
        }

        if (($s['prompt_context'] ?? '') !== '') {
            $out .= $s['prompt_context'] . "\n";
        }

        if ($questions) {
            $out .= "Multi-question prompt: answer all with --answers JSON, one entry per question\n";

            foreach ($questions as $i => $q) {
                $out .= ($i + 1) . '. ' . (string)($q['question'] ?? $q['header'] ?? '') . "\n";

                foreach ($q['options'] ?? [] as $j => $o) {
                    $out .= '     ' . ($j + 1) . '. ' . (string)($o['label'] ?? '') . "\n";
                }
            }
        }

        foreach ($options as $o) {
            $out .= '  ' . $o['number'] . '. ' . $o['label'] . "\n";
        }
    }

    $text = transcript_text($s['last_message'] ?? null);

    if ($text !== '') {
        $out .= "\nLast message (" . (string)($s['last_message']['role'] ?? '?') . "):\n" . $text . "\n";
    }

    foreach ($s['history'] ?? [] as $entry) {
        $out .= "\n[" . (string)($entry['role'] ?? '?') . '] ' . transcript_text($entry) . "\n";
    }

    return $out;
}

/** @param  array<string, mixed>|null  $entry */
function transcript_text(?array $entry): string
{
    $parts = [];

    foreach ($entry['blocks'] ?? [] as $b) {
        if (($b['kind'] ?? null) === 'text') {
            $parts[] = (string)$b['text'];
        }
    }

    return implode("\n\n", $parts);
}

/** @param  array<string, mixed>  $envelope */
function emit_envelope(array $envelope): void
{
    echo json_encode($envelope, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
}

$opts = getopt('h', ['agent:', 'resume:', 'workdir:', 'model:', 'effort:', 'mode:', 'profile:', 'task-tools', 'no-tools', 'allowed-tools:', 'disallowed-tools:', 'json', 'help', 'kill:', 'force', 'list', 'send:', 'whoami', 'peers', 'usage', 'advise', 'act', 'wait', 'timeout:', 'show:', 'history:', 'answer:', 'option:', 'text:', 'answers:', 'expect:', 'expect-request:', 'interrupt:', 'bare', 'take-over:', 'as-user'], $restIndex);

if ($opts === false) {
    fail("bad options\n\n" . usage());
}

if (isset($opts['h']) || isset($opts['help'])) {
    echo usage();
    exit(0);
}

$positional = array_slice($argv, $restIndex);

/** One scalar string option, or null. */
$opt = static function (string $name) use ($opts): ?string {
    $value = $opts[$name] ?? null;

    if (is_array($value)) {
        fail("--{$name} given more than once");
    }

    return is_string($value) && $value !== '' ? $value : null;
};

$prompt = implode(' ', $positional);

if ($prompt === '-') {
    $prompt = (string)stream_get_contents(STDIN);
}

$resume = $opt('resume');
$workdir = $opt('workdir') ?? ($resume === null ? getcwd() : null);

if ($workdir !== null && $workdir[0] !== '/') {
    $real = realpath($workdir);
    $workdir = $real !== false ? $real : $workdir;
}

if (getenv('SESSIONEER_AGENT_SOCKET') === false || getenv('SESSIONEER_AGENT_SOCKET') === '') {
    putenv('SESSIONEER_AGENT_SOCKET=' . (getenv('XDG_RUNTIME_DIR') ?: '/run/user/' . posix_getuid()) . '/sessioneer-agent.sock');
}

// A Codex session carries no SESSIONEER_SELF; its thread id is its session name.
$self = getenv('SESSIONEER_SELF') ?: getenv('CODEX_THREAD_ID') ?: null;

if (isset($opts['whoami'])) {
    if ($self === null) {
        fail('not running inside a Sessioneer session (neither SESSIONEER_SELF nor CODEX_THREAD_ID is set)');
    }

    echo $self, "\n";
    exit(0);
}

$kill = $opt('kill');
$list = isset($opts['list']);
$send = $opt('send');
$peers = isset($opts['peers']);
$advise = isset($opts['advise']);
$show = $opt('show');
$answer = $opt('answer');
$interrupt = $opt('interrupt');
$bare = isset($opts['bare']);
$takeOver = $opt('take-over');

// Every action that is not a launch or a resume.
$nonLaunch = $kill !== null || $list || $send !== null || $peers || $show !== null || $answer !== null || $interrupt !== null || $bare || $takeOver !== null;

if (count(array_filter([$kill !== null, $list, $send !== null, $peers, isset($opts['usage']), $advise, $show !== null, $answer !== null, $interrupt !== null, $bare, $takeOver !== null])) > 1) {
    fail('--kill, --list, --show, --answer, --interrupt, --bare, --take-over, --send, --peers, --usage and --advise cannot be combined');
}

// Modifiers belong to one action each; a stray one would otherwise be ignored.
foreach ([
    'history' => [$show !== null, '--history only applies to --show'],
    'option' => [$answer !== null, '--option only applies to --answer'],
    'text' => [$answer !== null, '--text only applies to --answer'],
    'answers' => [$answer !== null, '--answers only applies to --answer'],
    'expect' => [$answer !== null, '--expect only applies to --answer'],
    'expect-request' => [$answer !== null, '--expect-request only applies to --answer'],
    'as-user' => [$send !== null, '--as-user only applies to --send'],
] as $modifier => [$allowed, $message]) {
    if (isset($opts[$modifier]) && !$allowed) {
        fail($message);
    }
}

if ($resume !== null && $nonLaunch && $takeOver === null) {
    fail('--resume only applies to launching a session or to --take-over');
}

$history = $opt('history');

if ($history !== null && (!ctype_digit($history) || (int)$history < 1)) {
    fail('--history must be a positive number of entries');
}

$answerPayload = [];

if ($answer !== null) {
    $optionNumber = $opt('option');
    $answersJson = $opt('answers');

    if (($optionNumber === null) === ($answersJson === null)) {
        fail('--answer needs exactly one of --option N or --answers JSON');
    }

    if ($optionNumber !== null && (!ctype_digit($optionNumber) || (int)$optionNumber < 1)) {
        fail('--option must be a positive option number');
    }

    if ($answersJson !== null) {
        $decoded = json_decode($answersJson === '-' ? (string)stream_get_contents(STDIN) : $answersJson, true);

        if (!is_array($decoded) || $decoded === []) {
            fail('--answers must be a non-empty JSON list, one entry per question');
        }

        if ($opt('text') !== null || $opt('expect') !== null) {
            fail('--text and --expect go with --option, not --answers');
        }

        $answerPayload = ['answers' => $decoded, 'expected_request_id' => $opt('expect-request')];
    } else {
        $answerPayload = ['option' => (int)$optionNumber, 'text' => $opt('text'), 'expected_label' => $opt('expect'), 'expected_request_id' => $opt('expect-request')];
    }
}

if (isset($opts['act']) && !$advise) {
    fail('--act only applies to --advise');
}

if ($advise) {
    if (isset($opts['act']) && count($positional) !== 1) {
        fail('--advise --act needs exactly one session name or conversation id');
    }

    $reply = AgentClient::agent_call(array_filter([
        'action' => 'advise',
        'target' => $positional[0] ?? null,
        'act' => isset($opts['act']) ? true : null,
        'model' => $opt('model'),
        'effort' => $opt('effort'),
    ], static fn ($v): bool => $v !== null && $v !== ''));

    if (isset($opts['json'])) {
        echo json_encode($reply, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
    } elseif (($reply['ok'] ?? false) === true && !isset($opts['act'])) {
        foreach ($reply['sessions'] as $s) {
            $a = $s['advice'];
            echo implode("\t", [
                $s['name'], $s['status'], strtoupper((string)$a['verdict']),
                isset($a['context_tokens']) ? round($a['context_tokens'] / 1000) . 'k' : '-',
                isset($a['cache_age_seconds']) ? ($a['cache_cold'] ? 'cold ' : 'warm ') . round($a['cache_age_seconds'] / 60) . 'm' : '-',
                $a['reason'],
            ]), "\n";
        }
    } else {
        fwrite(STDERR, 'sessioneer: ' . (string)($reply['message'] ?? 'done') . "\n");
    }

    exit(($reply['ok'] ?? false) === true ? 0 : 1);
}

if (isset($opts['usage'])) {
    $reply = AgentClient::agent_call(['action' => 'quota']);

    if (!isset($reply['agents'], $reply['claude_profiles'])) {
        fail((string)($reply['message'] ?? 'usage unavailable'));
    }

    // One shape for every agent: label plus profiles.<name>. An agent with a single account is profiles.default;
    // a top-level quota is never exposed because it cannot say which account it belongs to.
    $agents = [];
    foreach ($reply['agents'] as $key => $agent) {
        $profiles = $key === 'claude'
            ? $reply['claude_profiles']
            : ['default' => array_diff_key($agent, ['label' => 1])];
        $agents[$key] = ['label' => $agent['label'] ?? $key, 'profiles' => $profiles];
    }

    echo json_encode(['agents' => $agents], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
    exit(0);
}

if (isset($opts['no-tools'])) {
    if ($resume !== null || $nonLaunch) {
        fail('--no-tools only applies to starting a new session');
    }

    if (isset($opts['task-tools'])) {
        fail('--no-tools and --task-tools cannot be combined');
    }
}

foreach (['allowed-tools', 'disallowed-tools'] as $toolOption) {
    if (isset($opts[$toolOption])) {
        if (is_string($opts[$toolOption]) && trim($opts[$toolOption]) === '') {
            fail("--{$toolOption} needs a non-empty list");
        }

        if ($resume !== null || $nonLaunch) {
            fail("--{$toolOption} only applies to starting a new session");
        }

        if (isset($opts['no-tools'])) {
            fail("--{$toolOption} and --no-tools cannot be combined: --no-tools already removes every tool");
        }
    }
}

if ($opt('effort') !== null && $nonLaunch) {
    fail('--effort only applies to launching or resuming a session');
}

// An Ollama session is a local model reached over Sessioneer's own HTTP
// client: no account, no reasoning levels, no permission modes, no tools.
if ($opt('agent') === 'ollama') {
    foreach ([
        'profile' => '--profile has no meaning for --agent ollama: a local model runs under no account',
        'effort' => '--effort has no meaning for --agent ollama: a local model has no reasoning levels',
        'mode' => '--mode has no meaning for --agent ollama: its sessions have no permission modes',
        'no-tools' => '--no-tools has no meaning for --agent ollama: its sessions never have tools',
        'task-tools' => '--task-tools has no meaning for --agent ollama: its sessions never have tools',
        'allowed-tools' => '--allowed-tools has no meaning for --agent ollama: its sessions never have tools',
        'disallowed-tools' => '--disallowed-tools has no meaning for --agent ollama: its sessions never have tools',
    ] as $option => $message) {
        if (isset($opts[$option])) {
            fail($message);
        }
    }
}

// An OpenCode session is a serve-hosted conversation: no account profile,
// reasoning-level control, permission-mode vocabulary or tool-set flags.
if ($opt('agent') === 'opencode') {
    foreach ([
        'profile' => '--profile has no meaning for --agent opencode: its serve sessions have no account profile',
        'effort' => '--effort has no meaning for --agent opencode: the serve has no reasoning-level control',
        'mode' => '--mode has no meaning for --agent opencode: its sessions have no permission modes',
        'no-tools' => '--no-tools has no meaning for --agent opencode: the serve session\'s tools are not configurable here',
        'task-tools' => '--task-tools has no meaning for --agent opencode: the serve session\'s tools are not configurable here',
        'allowed-tools' => '--allowed-tools has no meaning for --agent opencode: the serve session\'s tools are not configurable here',
        'disallowed-tools' => '--disallowed-tools has no meaning for --agent opencode: the serve session\'s tools are not configurable here',
    ] as $option => $message) {
        if (isset($opts[$option])) {
            fail($message);
        }
    }
}

// Validated before the request: a bad --timeout used to be caught after the
// launch, which left the session it had just created running.
if (isset($opts['wait'])) {
    if ($nonLaunch) {
        fail('--wait only applies to launching or resuming a session');
    }

    $timeout = $opt('timeout');

    if ($timeout !== null && (!ctype_digit($timeout) || (int)$timeout < 1)) {
        fail('--timeout must be a positive number of seconds');
    }
}

$action = match (true) {
    $kill !== null => 'launch_kill',
    $list => 'launch_list',
    $send !== null => 'launch_send',
    $peers => 'launch_peers',
    $show !== null => 'launch_show',
    $answer !== null => 'launch_answer',
    $interrupt !== null => 'launch_interrupt',
    $bare => 'launch_bare',
    $takeOver !== null => 'launch_take_over',
    default => 'launch',
};

$reply = AgentClient::agent_call(array_filter([
    'action' => $action,
    'agent' => $opt('agent'),
    'prompt' => $prompt,
    'agent_session_id' => $resume,
    'workdir' => $takeOver !== null ? null : $workdir,
    'model' => $opt('model'),
    'effort' => $opt('effort'),
    'starting_mode' => $opt('mode'),
    'profile' => $opt('profile'),
    'caller_config_dir' => $opt('profile') === null ? (getenv('CLAUDE_CONFIG_DIR') ?: null) : null,
    'enable_task_tools' => isset($opts['task-tools']) ? true : null,
    'no_tools' => isset($opts['no-tools']) ? true : null,
    'allowed_tools' => $opt('allowed-tools'),
    'disallowed_tools' => $opt('disallowed-tools'),
    'target' => $kill ?? $send ?? $show ?? $answer ?? $interrupt ?? $takeOver,
    'message' => $send !== null ? $prompt : null,
    'from' => $send !== null || $peers || $answer !== null ? $self : null,
    'force' => isset($opts['force']) ? true : null,
    'as_user' => isset($opts['as-user']) ? true : null,
    'history' => $history !== null ? (int)$history : null,
] + $answerPayload, static fn ($v): bool => $v !== null && $v !== ''));

$ok = ($reply['ok'] ?? false) === true;

if (isset($opts['wait'])) {
    $json = isset($opts['json']);
    $agentName = $opt('agent') ?? 'claude';
    $modelName = $opt('model');

    // Fails a --wait run without breaking the JSON contract: the envelope goes
    // to stdout when it was asked for, the human message to stderr, exit 1
    // either way.
    $waitFail = static function (string $kind, string $message, ?string $session, ?array $detail = null) use ($json, $agentName, $modelName, $workdir): never {
        if ($json) {
            emit_envelope(wait_envelope(
                false,
                null,
                $session,
                is_string($detail['agent_session_id'] ?? null) ? $detail['agent_session_id'] : null,
                is_string($detail['agent'] ?? null) ? $detail['agent'] : $agentName,
                $modelName,
                is_string($detail['workdir'] ?? null) ? $detail['workdir'] : $workdir,
                ['kind' => $kind, 'message' => $message],
            ));
        }

        fail($message);
    };

    if (!$ok) {
        $waitFail('launch_refused', (string)($reply['message'] ?? 'launch failed'), is_string($reply['name'] ?? null) ? $reply['name'] : null);
    }

    $name = (string)($reply['name'] ?? '');
    $deadline = $timeout !== null ? time() + (int)$timeout : null;
    fwrite(STDERR, $name . "\n");

    // The launch reply is only sent once the prompt was accepted, so the turn
    // has started; idle after that means it finished.
    $detail = null;

    while (true) {
        $d = AgentClient::agent_call(['action' => 'session_detail', 'session' => $name]);

        if (($d['ok'] ?? false) !== true) {
            $waitFail('session_error', 'session ' . $name . ': ' . (string)($d['message'] ?? 'detail unavailable'), $name, $detail);
        }

        $detail = $d;

        if (is_string($d['last_turn_error'] ?? null) && $d['last_turn_error'] !== '') {
            $waitFail('turn_error', 'session ' . $name . ' errored: ' . $d['last_turn_error'], $name, $detail);
        }

        // A new Codex thread reports idle for a few seconds after its prompt is accepted, before the
        // turn goes active; only an assistant reply as the last message proves the turn happened.
        $replied = $opt('agent') !== 'codex' || ($d['last_message']['role'] ?? null) === 'assistant';

        if ($replied && (($d['status'] ?? null) === 'idle' || (!isset($d['status']) && empty($d['working'])))) {
            $text = [];

            foreach ($d['last_message']['blocks'] ?? [] as $b) {
                if (($b['kind'] ?? null) === 'text') {
                    $text[] = (string)$b['text'];
                }
            }

            $answer = implode("\n\n", $text);

            if ($json) {
                emit_envelope(wait_envelope(
                    true,
                    $answer,
                    $name,
                    is_string($d['agent_session_id'] ?? null) ? $d['agent_session_id'] : null,
                    is_string($d['agent'] ?? null) ? $d['agent'] : $agentName,
                    $modelName,
                    is_string($d['workdir'] ?? null) ? $d['workdir'] : $workdir,
                    null,
                ));
            } else {
                echo $answer, "\n";
            }

            exit(0);
        }

        if ($deadline !== null && time() >= $deadline) {
            $waitFail('timeout', 'timed out after ' . $timeout . 's waiting for ' . $name, $name, $detail);
        }

        sleep(2);
    }
}

if (isset($opts['json'])) {
    echo json_encode($reply, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
} elseif ($ok && $list) {
    foreach ($reply['sessions'] ?? [] as $s) {
        echo implode("\t", [(string)$s['name'], (string)$s['status'], (string)($s['agent_session_id'] ?? '-'), (string)($s['workdir'] ?? '-')]), "\n";
    }
} elseif ($ok && $show !== null) {
    echo show_text($reply);
} elseif ($ok && $bare) {
    foreach ($reply['bare'] ?? [] as $b) {
        echo implode("\t", [(string)$b['pid'], (string)($b['resolved_agent_session_id'] ?? '-'), (string)($b['cwd'] ?? '-'), (string)($b['resolved_title'] ?? '-')]), "\n";
    }
} elseif ($ok && $takeOver !== null && ($reply['needs_choice'] ?? false) === true) {
    // Nothing was stopped: say which conversations it might be, and how to pick one.
    foreach ($reply['candidates'] ?? [] as $c) {
        echo implode("\t", [(string)($c['agent_session_id'] ?? '-'), (string)($c['title'] ?? '-')]), "\n";
    }

    fwrite(STDERR, 'sessioneer: cannot tell for certain which conversation pid ' . (string)($reply['pid'] ?? $takeOver) . " runs; nothing was stopped. Repeat with --resume ID to take over the right one"
        . (isset($reply['suggested_agent_session_id']) ? ' (suggested: ' . $reply['suggested_agent_session_id'] . ')' : '') . ".\n");
    exit(1);
} elseif ($ok && $peers) {
    foreach ($reply['peers'] ?? [] as $p) {
        echo implode("\t", [(string)$p['name'], (string)$p['status'], (string)($p['branch'] ?? '-'), (string)($p['workdir'] ?? '-')]), "\n";
    }
} elseif ($ok) {
    echo (string)($reply['name'] ?? ''), "\n";
    fwrite(STDERR, (string)($reply['message'] ?? '') . "\n");
} else {
    fwrite(STDERR, 'sessioneer: ' . (string)($reply['message'] ?? 'launch failed') . "\n");
}

exit($ok ? 0 : 1);
