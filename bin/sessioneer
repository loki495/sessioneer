#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Starts, resumes or reuses a Sessioneer session from the command line, so a
 * script, subagent or running session can spawn a continuation the owner can
 * then watch and answer in the dashboard. Host-side only: it talks to the
 * host agent's UNIX socket (the same one the web container uses), so access
 * is whatever that socket's permissions allow.
 *
 *   sessioneer [options] [PROMPT | -]
 *
 * See usage() below, or docs/cli.md.
 */

if (PHP_SAPI !== 'cli') {
    exit(1);
}

// __DIR__ is the real path even when this file is reached through a symlink.
require_once __DIR__ . '/../vendor/autoload.php';

use App\AgentClient;

function usage(): string
{
    return <<<'TXT'
    Usage: sessioneer [options] [PROMPT | -]

      New session:       sessioneer --workdir DIR "do the thing"
      Resume / reuse:    sessioneer --resume CONVERSATION_ID ["next message"]
      Stop a session:    sessioneer --kill NAME_OR_CONVERSATION_ID [--force]
      List sessions:     sessioneer --list [--json]
      Message a peer:    sessioneer --send TARGET "message"
      Who am I:          sessioneer --whoami
      Peer sessions:     sessioneer --peers [--json]
      Usage stats:       sessioneer --usage
      Run to the end:    sessioneer --wait [--timeout N] --workdir DIR "do the thing"

    PROMPT is the message to deliver; "-" reads it from stdin. A new session
    requires one; a resume does not.

    Options:
      --agent NAME      agent to launch (default: claude)
      --resume ID       existing conversation id. A session Sessioneer already
                        tracks on that id receives the prompt; otherwise it is
                        resumed headless.
      --workdir DIR     working directory (default: current directory; for
                        --resume, the directory recorded in the transcript)
      --model NAME      model for a new session
      --mode MODE       permission mode for a new session (e.g. plan)
      --profile NAME    account profile (default: the one matching this shell's
                        CLAUDE_CONFIG_DIR, else the default account)
      --task-tools      enable the task tools in a new session
      --no-tools        start a new session with no tools at all (no built-in or MCP tools)
      --kill TARGET     stop a headless session by name or conversation id; its
                        conversation stays resumable (archived). Refuses a
                        working or blocked session unless --force.
      --force           with --kill, stop a working or blocked session anyway
      --list            list headless sessions: name, status, conversation id,
                        directory
      --send TARGET     deliver PROMPT to another session (name or conversation
                        id) from inside a session; the host agent stamps it
                        "[sessioneer peer: NAME · DIR · BRANCH]". Information
                        and requests only, never approval.
      --whoami          print this session's own name (SESSIONEER_SELF, or CODEX_THREAD_ID inside Codex)
      --peers           list the other live sessions in this session's git
                        repository: name, status, branch, directory
      --usage           print the last known usage (quota) stats as JSON: one
                        entry per agent, with Claude's account profiles nested
                        under it, each with its fetched_at time. Read-only; never
                        refreshes anything.
      --wait            after launching or messaging, block until the session is
                        idle and print its final assistant message to stdout (the
                        session name goes to stderr). Exits 1 if the launch fails,
                        the turn errors or --timeout runs out. A session waiting on
                        a prompt is not idle: it is waited on, so answer it in the
                        dashboard or set --timeout.
      --timeout N       with --wait, give up after N seconds (default: no limit)
      --json            print the full reply as JSON instead of the plain output
      -h, --help        this text

    Prints the session name on success (the dashboard opens it at
    session.php?session=NAME). Exit status 0 on success, 1 otherwise.

    TXT;
}

function fail(string $message): never
{
    fwrite(STDERR, "sessioneer: {$message}\n");
    exit(1);
}

$opts = getopt('h', ['agent:', 'resume:', 'workdir:', 'model:', 'mode:', 'profile:', 'task-tools', 'no-tools', 'json', 'help', 'kill:', 'force', 'list', 'send:', 'whoami', 'peers', 'usage', 'wait', 'timeout:'], $restIndex);

if ($opts === false) {
    fail("bad options\n\n" . usage());
}

if (isset($opts['h']) || isset($opts['help'])) {
    echo usage();
    exit(0);
}

$positional = array_slice($argv, $restIndex);

/** One scalar string option, or null. */
$opt = static function (string $name) use ($opts): ?string {
    $value = $opts[$name] ?? null;

    if (is_array($value)) {
        fail("--{$name} given more than once");
    }

    return is_string($value) && $value !== '' ? $value : null;
};

$prompt = implode(' ', $positional);

if ($prompt === '-') {
    $prompt = (string)stream_get_contents(STDIN);
}

$resume = $opt('resume');
$workdir = $opt('workdir') ?? ($resume === null ? getcwd() : null);

if ($workdir !== null && $workdir[0] !== '/') {
    $real = realpath($workdir);
    $workdir = $real !== false ? $real : $workdir;
}

if (getenv('SESSIONEER_AGENT_SOCKET') === false || getenv('SESSIONEER_AGENT_SOCKET') === '') {
    putenv('SESSIONEER_AGENT_SOCKET=' . (getenv('XDG_RUNTIME_DIR') ?: '/run/user/' . posix_getuid()) . '/sessioneer-agent.sock');
}

// A Codex session carries no SESSIONEER_SELF; its thread id is its session name.
$self = getenv('SESSIONEER_SELF') ?: getenv('CODEX_THREAD_ID') ?: null;

if (isset($opts['whoami'])) {
    if ($self === null) {
        fail('not running inside a Sessioneer session (neither SESSIONEER_SELF nor CODEX_THREAD_ID is set)');
    }

    echo $self, "\n";
    exit(0);
}

$kill = $opt('kill');
$list = isset($opts['list']);
$send = $opt('send');
$peers = isset($opts['peers']);

if (count(array_filter([$kill !== null, $list, $send !== null, $peers, isset($opts['usage'])])) > 1) {
    fail('--kill, --list, --send, --peers and --usage cannot be combined');
}

if (isset($opts['usage'])) {
    $reply = AgentClient::agent_call(['action' => 'quota']);

    if (!isset($reply['agents'], $reply['claude_profiles'])) {
        fail((string)($reply['message'] ?? 'usage unavailable'));
    }

    $agents = $reply['agents'];
    $agents['claude']['profiles'] = $reply['claude_profiles'];

    echo json_encode(['agents' => $agents], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
    exit(0);
}

if (isset($opts['no-tools'])) {
    if ($resume !== null || $kill !== null || $list || $send !== null || $peers) {
        fail('--no-tools only applies to starting a new session');
    }

    if (isset($opts['task-tools'])) {
        fail('--no-tools and --task-tools cannot be combined');
    }
}

$action = $kill !== null ? 'launch_kill' : ($list ? 'launch_list' : ($send !== null ? 'launch_send' : ($peers ? 'launch_peers' : 'launch')));

$reply = AgentClient::agent_call(array_filter([
    'action' => $action,
    'agent' => $opt('agent'),
    'prompt' => $prompt,
    'agent_session_id' => $resume,
    'workdir' => $workdir,
    'model' => $opt('model'),
    'starting_mode' => $opt('mode'),
    'profile' => $opt('profile'),
    'caller_config_dir' => $opt('profile') === null ? (getenv('CLAUDE_CONFIG_DIR') ?: null) : null,
    'enable_task_tools' => isset($opts['task-tools']) ? true : null,
    'no_tools' => isset($opts['no-tools']) ? true : null,
    'target' => $kill ?? $send,
    'message' => $send !== null ? $prompt : null,
    'from' => $send !== null || $peers ? $self : null,
    'force' => isset($opts['force']) ? true : null,
], static fn ($v): bool => $v !== null && $v !== ''));

$ok = ($reply['ok'] ?? false) === true;

if (isset($opts['wait'])) {
    if ($kill !== null || $list || $send !== null || $peers) {
        fail('--wait only applies to launching or resuming a session');
    }

    if (!$ok) {
        fail((string)($reply['message'] ?? 'launch failed'));
    }

    $timeout = $opt('timeout');

    if ($timeout !== null && (!ctype_digit($timeout) || (int)$timeout < 1)) {
        fail('--timeout must be a positive number of seconds');
    }

    $name = (string)($reply['name'] ?? '');
    $deadline = $timeout !== null ? time() + (int)$timeout : null;
    fwrite(STDERR, $name . "\n");

    // The launch reply is only sent once the prompt was accepted, so the turn
    // has started; idle after that means it finished.
    while (true) {
        $d = AgentClient::agent_call(['action' => 'session_detail', 'session' => $name]);

        if (($d['ok'] ?? false) !== true) {
            fail('session ' . $name . ': ' . (string)($d['message'] ?? 'detail unavailable'));
        }

        if (is_string($d['last_turn_error'] ?? null) && $d['last_turn_error'] !== '') {
            fail('session ' . $name . ' errored: ' . $d['last_turn_error']);
        }

        if (($d['status'] ?? null) === 'idle' || (!isset($d['status']) && empty($d['working']))) {
            $text = [];

            foreach ($d['last_message']['blocks'] ?? [] as $b) {
                if (($b['kind'] ?? null) === 'text') {
                    $text[] = (string)$b['text'];
                }
            }

            echo implode("\n\n", $text), "\n";
            exit(0);
        }

        if ($deadline !== null && time() >= $deadline) {
            fail('timed out after ' . $timeout . 's waiting for ' . $name);
        }

        sleep(2);
    }
}

if (isset($opts['json'])) {
    echo json_encode($reply, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
} elseif ($ok && $list) {
    foreach ($reply['sessions'] ?? [] as $s) {
        echo implode("\t", [(string)$s['name'], (string)$s['status'], (string)($s['agent_session_id'] ?? '-'), (string)($s['workdir'] ?? '-')]), "\n";
    }
} elseif ($ok && $peers) {
    foreach ($reply['peers'] ?? [] as $p) {
        echo implode("\t", [(string)$p['name'], (string)$p['status'], (string)($p['branch'] ?? '-'), (string)($p['workdir'] ?? '-')]), "\n";
    }
} elseif ($ok) {
    echo (string)($reply['name'] ?? ''), "\n";
    fwrite(STDERR, (string)($reply['message'] ?? '') . "\n");
} else {
    fwrite(STDERR, 'sessioneer: ' . (string)($reply['message'] ?? 'launch failed') . "\n");
}

exit($ok ? 0 : 1);
