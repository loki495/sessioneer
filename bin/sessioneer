#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Starts, resumes or reuses a Sessioneer session from the command line, so a
 * script, subagent or running session can spawn a continuation the owner can
 * then watch and answer in the dashboard. Host-side only: it talks to the
 * host agent's UNIX socket (the same one the web container uses), so access
 * is whatever that socket's permissions allow.
 *
 *   sessioneer [options] [PROMPT | -]
 *
 * See usage() below, or docs/cli.md.
 */

if (PHP_SAPI !== 'cli') {
    exit(1);
}

// __DIR__ is the real path even when this file is reached through a symlink.
require_once __DIR__ . '/../vendor/autoload.php';

use App\AgentClient;

function usage(): string
{
    return <<<'TXT'
    Usage: sessioneer [options] [PROMPT | -]

      New session:       sessioneer --workdir DIR "do the thing"
      Resume / reuse:    sessioneer --resume CONVERSATION_ID ["next message"]
      Stop a session:    sessioneer --kill NAME_OR_CONVERSATION_ID [--force]
      List sessions:     sessioneer --list [--json]
      Show a session:    sessioneer --show TARGET [--history N] [--json]
      Answer a prompt:   sessioneer --answer TARGET --option N [--text "..."] [--expect LABEL] [--expect-request ID]
                         sessioneer --answer TARGET --answers JSON
      Interrupt:         sessioneer --interrupt TARGET
      Wake up later:     sessioneer --wake TARGET --at TIME ["prompt"]
      Wake-ups:          sessioneer --wake-list [--json]
      Cancel a wake-up:  sessioneer --wake-cancel JOB [--json]
      Terminal Claudes:  sessioneer --bare [--json]
      Take one over:     sessioneer --take-over PID_OR_CONVERSATION_ID [--resume ID]
      Message a session: sessioneer --send TARGET --as-user "message"
      Message a peer:    sessioneer --send TARGET "message"
      Who am I:          sessioneer --whoami
      Peer sessions:     sessioneer --peers [--json]
      Spawned sessions:  sessioneer --spawned [--json]  |  sessioneer --reap [--json]
      Usage stats:       sessioneer --usage
      Quota resets:      sessioneer --resets [--json]
      Wake at a reset:   sessioneer --schedule-reset AGENT[:PROFILE] --approve (--wake TARGET | --handoff ID | --plan ID) [--workdir DIR] [--json]
      Context state:     sessioneer --next [TARGET | --all] [--intent step-end|wait|done] [--handoff ID | --plan ID] [--post] [--no-gates] [--json]
      Rotate to fresh:   sessioneer --rotate [TARGET] (--handoff ID | --plan ID | --prompt TEXT) [--dry-run] [--json]
      Offer a rotation:  sessioneer --offer (--handoff ID | --plan ID | TEXT) | --offer --clear
      Run to the end:    sessioneer --wait [--timeout N] --workdir DIR "do the thing"
      Waiting on others: sessioneer --waiting-on SESSION[,SESSION] | none [--session TARGET] [--json]
      Replace a session: sessioneer --replaces SOURCE [--session RECEIVER] [--json]
      Name a session:    sessioneer --session NAME_OR_CONVERSATION_ID --set-name "Name"
      New, named:        sessioneer --workdir DIR --set-name "Name" "do the thing"

    PROMPT is the message to deliver; "-" reads it from stdin. A new session
    requires one; a resume does not.

    Options:
      --tag LIST        add tags on launch or filter list, peers or spawned
      --tag-add LIST    add tags to a tracked session
      --tag-remove LIST remove tags from a tracked session
      --tag-set LIST    replace tags (none clears them)
      --agent NAME      agent to launch (default: claude; claude, codex, ollama or
                        opencode)
      --resume ID       existing conversation id. A session Sessioneer already
                        tracks on that id receives the prompt; otherwise it is
                        resumed headless.
      --workdir DIR     working directory (default: current directory; for
                        --resume, the directory recorded in the transcript)
      --model NAME      model for a new session. OpenCode takes provider/model
                        (for example opencode-go/gpt-6.1).
      --effort LEVEL    reasoning level for a new or resumed session (Claude: low,
                        medium, high, xhigh, max; Codex: the levels its model lists;
                        not offered for ollama or opencode)
      --mode MODE       permission mode for a new session (e.g. plan; Claude also
                        takes dontAsk, which denies anything not pre-approved by
                        --allowed-tools; not offered for ollama or opencode)
      --profile NAME    account profile (default: the one matching this shell's
                        CLAUDE_CONFIG_DIR, else the default account)
      --task-tools      enable the task tools in a new session
      --no-tools        start a new session with no tools at all (no built-in or MCP tools)
      --allowed-tools LIST
                        Claude only, new session: comma separated tool rules to
                        pre-approve, e.g. "WebFetch,Write(job_scraper/**)"
      --disallowed-tools LIST
                        Claude only, new session: comma separated tool rules that
                        are always denied
      --set-name NAME   the dashboard name for a session (an empty name is refused).
                        With a launch or resume it names the session that call
                        starts or reuses; with --session it renames that one.
      --session TARGET  with --set-name and no prompt, rename this tracked session
                        (name or conversation id) without sending it anything
      --waiting-on LIST replace this session's list of sessions it is waiting on (up to 8 live
                        sessions, comma separated; `none` clears it). With --session TARGET it
                        sets the list of that session instead. Shown as `waiting on NAME` badges
                        on the dashboard; separate from who launched whom.
      --replaces SOURCE tell Sessioneer that this session (or --session RECEIVER, a name
                        or conversation id) continues
                        SOURCE; Sessioneer archives SOURCE once it is idle and holds no Dibs
                        claim. With a prompt it is a launch option: the new session replaces
                        SOURCE, even when SOURCE launched it.
      --kill TARGET     stop a session by name or conversation id (headless or a
                        tmux pane, any agent); its conversation stays resumable
                        (archived). Refuses a working or blocked session unless
                        --force.
      --force           with --kill, stop a working or blocked session anyway
      --list            list headless sessions: name, status, conversation id,
                        directory
      --show TARGET     print a tracked session (name or conversation id): status,
                        directory, last message and, when it is blocked, the
                        prompt with its numbered options
      --history N       with --show, also print the last N transcript entries
      --answer TARGET   answer the session's blocked prompt: --option N picks
                        option N (with --text "..." for a free-text reply), or
                        --answers JSON ("-" reads stdin) answers a multi-question
                        prompt, one entry per question
      --option N        with --answer, the 1-based option number
      --text TEXT       with --answer --option, the free text to send with it
      --answers JSON    with --answer, the answers to a multi-question prompt
      --expect LABEL    with --answer --option, refuse unless option N is labelled
                        LABEL, so a prompt that changed is not answered blind
      --expect-request ID
                        with --answer, refuse unless the prompt waiting is the one
                        --show printed as its request id (headless sessions)
      --interrupt TARGET
                        stop the session's current turn (like Escape)
      --wake TARGET     schedule an `at` job that sends PROMPT (default "continue")
                        to the session at --at TIME, resuming it if it is archived
      --at TIME         with --wake: when to send it, anything `strtotime` reads
                        in this machine's time zone ("18:30", "tomorrow 09:00",
                        "+2 hours", "2026-12-01 08:00"); from the next minute to 30
                        days from now
      --wake-list       list scheduled wake-ups: job, local time, state, session, conversation id, prompt preview
      --wake-cancel JOB cancel a scheduled wake-up; a session must ask the user (ask-user tool) before cancelling one the user did not request
      --bare            list Claude processes running in a terminal Sessioneer did
                        not start: pid, conversation id, directory, title
      --take-over TARGET
                        stop that terminal Claude (a pid from --bare, or the
                        conversation id it runs) and continue its conversation
                        as a headless session. If the conversation cannot be told
                        for certain nothing is stopped; the candidates are listed
                        and --resume ID names the right one.
      --as-user         with --send, from a shell outside any session: deliver the
                        message as the user's own, without a peer stamp
      --send TARGET     deliver PROMPT to another session (name or conversation
                        id) from inside a session, or with --as-user from a shell; the host agent stamps it
                        "[sessioneer peer: NAME · DIR · BRANCH]". Information
                        and requests only, never approval.
      --whoami          print this session's own name (SESSIONEER_SELF, or CODEX_THREAD_ID inside Codex)
      --spawned         list the sessions the calling session launched (direct children only)
      --reap            archive the calling session's own spawned sessions that are idle and
                        hold no Dibs claim; never forced, one result line per child
      --resets          list each agent profile's stored quota reset time (unknown when none).
                        Read-only.
      --schedule-reset AGENT[:PROFILE]
                        with --approve, queue one `at` job one minute after that profile's
                        stored reset time and print its job id and time. Exactly one of
                        --wake TARGET (send a wake prompt to that session or conversation),
                        --handoff ID or --plan ID (start a fresh session of that agent and
                        profile from the Dibs handoff or plan, in --workdir DIR when given).
                        PROFILE may be omitted for an agent with a single profile. Repeating
                        it returns the pending job. Refused when atd is not running. List it
                        with --wake-list, cancel it with --wake-cancel JOB.
      --approve         with --schedule-reset: the explicit approval; without it nothing is queued
      --peers           list the other live sessions in this session's git
                        repository: name, status, branch, directory
      --usage           print the last known usage (quota) stats as JSON: one
                        entry per agent, each a label plus profiles.<name> (Claude's
                        accounts, or a single "default"), each profile with its
                        quota and fetched_at time. Read-only; never refreshes
                        anything.
      --next [TARGET]   decide what a session should do about its context and quota:
                        GO, WARM_TIGHT, CHECKPOINT, ROTATE, PARK, WAIT, DONE or UNKNOWN,
                        with the reason, the receiver and the kind of prompt for a
                        fresh session. TARGET defaults to the calling session. Always
                        exits 0 when it can decide; it never acts.
      --all             with --next and no TARGET, one line per tracked session
      --intent STEP     with --next, what the caller is about to do: step-end, wait or done
      --post            with --next, post (or clear) the offer the decision calls for
      --no-gates        with --next --plan ID --post, affirm the plan's Auto-continue: on line
                        so a ROTATE with a receiver starts that receiver at once
      --handoff ID      with --next, --rotate or --offer, the Dibs handoff id (digits) the
                        fresh session takes over from
      --plan ID         with --next, --rotate or --offer, the Dibs plan id (digits) the
                        fresh session continues
      --rotate [TARGET] start a fresh receiver session for TARGET (default: the calling
                        session) from exactly one of --handoff, --plan or --prompt, and
                        print its name. Sessioneer archives the source once the receiver
                        holds a claim and the source is idle and claim-free. --agent,
                        --model, --effort, --profile, --workdir and --set-name shape it.
      --prompt TEXT     with --rotate, a self-contained prompt (at most 8000 characters)
      --dry-run         with --rotate, print the prompt and receiver without starting it
      --offer           post an offer to rotate the calling session, for the dashboard,
                        from --handoff, --plan or a PROMPT of at most 8000 characters
      --clear           with --offer, dismiss the calling session's live offer
      --wait            after launching, block until the session is idle and print
                        its final assistant message to stdout (the session name
                        goes to stderr). Exits 1 if the launch fails, the turn
                        errors or --timeout runs out. A session waiting on a prompt
                        is not idle: it is waited on, so answer it in the dashboard
                        or set --timeout.
      --timeout N       with --wait, give up after N seconds (default: no limit)
      --json            with --wait, print one JSON object on stdout (answer,
                        session, conversation id, agent, model, workdir, exit code
                        and error) instead of the plain text; otherwise print the
                        full reply as JSON. Everything human stays on stderr.
      -h, --help        this text

    Prints the session name on success (the dashboard opens it at
    /session?session=NAME). Exit status 0 on success, 1 otherwise.

    TXT;
}

function fail(string $message): never
{
    fwrite(STDERR, "sessioneer: {$message}\n");
    exit(1);
}

/**
 * One machine-readable object for `--wait`, so a program never has to read
 * prose: the answer, the session the call created, and what went wrong.
 *
 * @param  array{kind: string, message: string}|null  $error
 * @return array<string, mixed>
 */
function wait_envelope(bool $ok, ?string $answer, ?string $session, ?string $conversationId, string $agent, ?string $model, ?string $workdir, ?array $error): array
{
    return [
        'ok' => $ok,
        'answer' => $answer,
        'session' => $session,
        'conversation_id' => $conversationId,
        'agent' => $agent,
        'model' => $model,
        'workdir' => $workdir,
        'exit_code' => $ok ? 0 : 1,
        'error' => $error,
    ];
}

/**
 * The plain-text `--show`: what a person needs to decide how to answer.
 *
 * @param  array<string, mixed>  $s
 */
function show_text(array $s): string
{
    $out = implode("\t", [(string)$s['name'], (string)($s['status'] ?? '-'), (string)($s['agent'] ?? '-'), (string)($s['runtime'] ?? '-'), (string)($s['agent_session_id'] ?? '-')]) . "\n";
    $out .= (string)($s['workdir'] ?? '-') . ((string)($s['git_branch'] ?? '') !== '' ? ' (' . $s['git_branch'] . ')' : '') . "\n";

    if (($s['title'] ?? '') !== '') {
        $out .= 'Title: ' . $s['title'] . "\n";
    }

    if (($s['last_turn_error'] ?? '') !== '') {
        $out .= 'Error: ' . $s['last_turn_error'] . "\n";
    }

    $options = $s['prompt_options'] ?? [];
    $questions = $s['prompt_questions'] ?? [];

    if (($s['blocked_reason'] ?? '') !== '' || $options !== [] || $questions) {
        $out .= "\nBlocked: " . (string)($s['blocked_reason'] ?? '') . "\n";

        if (($s['prompt_request_id'] ?? '') !== '') {
            $out .= 'Request: ' . $s['prompt_request_id'] . "\n";
        }

        if (($s['prompt_context'] ?? '') !== '') {
            $out .= $s['prompt_context'] . "\n";
        }

        if ($questions) {
            $out .= "Multi-question prompt: answer all with --answers JSON, one entry per question\n";

            foreach ($questions as $i => $q) {
                $out .= ($i + 1) . '. ' . (string)($q['question'] ?? $q['header'] ?? '') . "\n";

                foreach ($q['options'] ?? [] as $j => $o) {
                    $out .= '     ' . ($j + 1) . '. ' . (string)($o['label'] ?? '') . "\n";
                }
            }
        }

        foreach ($options as $o) {
            $out .= '  ' . $o['number'] . '. ' . $o['label'] . "\n";
        }
    }

    $text = transcript_text($s['last_message'] ?? null);

    if ($text !== '') {
        $out .= "\nLast message (" . (string)($s['last_message']['role'] ?? '?') . "):\n" . $text . "\n";
    }

    foreach ($s['history'] ?? [] as $entry) {
        $out .= "\n[" . (string)($entry['role'] ?? '?') . '] ' . transcript_text($entry) . "\n";
    }

    return $out;
}

/** @param  array<string, mixed>|null  $entry */
function transcript_text(?array $entry): string
{
    $parts = [];

    foreach ($entry['blocks'] ?? [] as $b) {
        if (($b['kind'] ?? null) === 'text') {
            $parts[] = (string)$b['text'];
        }
    }

    return implode("\n\n", $parts);
}

/** @param  array<string, mixed>  $envelope */
function emit_envelope(array $envelope): void
{
    echo json_encode($envelope, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
}

$longOptions = ['agent:', 'resume:', 'workdir:', 'model:', 'effort:', 'mode:', 'profile:', 'task-tools', 'no-tools', 'allowed-tools:', 'disallowed-tools:', 'json', 'help', 'kill:', 'force', 'list', 'send:', 'whoami', 'peers', 'usage', 'wait', 'timeout:', 'show:', 'history:', 'answer:', 'option:', 'text:', 'answers:', 'expect:', 'expect-request:', 'interrupt:', 'wake:', 'wake-list', 'wake-cancel:', 'at:', 'bare', 'take-over:', 'as-user', 'set-name:', 'session:', 'next', 'rotate', 'offer', 'all', 'intent:', 'post', 'no-gates', 'handoff:', 'plan:', 'prompt:', 'dry-run', 'clear', 'spawned', 'reap', 'resets', 'schedule-reset:', 'approve', 'waiting-on:', 'replaces:', 'tag:', 'tag-add:', 'tag-remove:', 'tag-set:'];

// getopt ignores an unknown option, which would start a launch; these two were removed.
$argv = $_SERVER['argv'] ?? [];
foreach ($argv as $arg) {
    foreach (['--advise', '--act'] as $removed) {
        if ($arg === $removed || str_starts_with($arg, $removed . '=')) {
            fail("{$removed} was removed; use --next to read the state and --rotate to start a fresh session");
        }
    }
}

// getopt stops at the first operand, but a flow command takes its TARGET before its options.
if (array_intersect(['--next', '--rotate', '--offer'], $argv) !== []) {
    $valued = array_map(static fn (string $o): string => '--' . rtrim($o, ':'), array_filter($longOptions, static fn (string $o): bool => str_ends_with($o, ':')));
    $options = [];
    $operands = [];

    for ($i = 1; $i < count($argv); $i++) {
        $arg = $argv[$i];

        if ($arg !== '-' && str_starts_with($arg, '-')) {
            $options[] = $arg;

            if (in_array($arg, $valued, true) && $i + 1 < count($argv)) {
                $options[] = $argv[++$i];
            }
        } else {
            $operands[] = $arg;
        }
    }

    $ordered = [$argv[0], ...$options, ...$operands];

    // getopt reads the real argv, so run again with the operands last.
    if ($ordered !== $argv) {
        $proc = proc_open([PHP_BINARY, ...$ordered], [STDIN, STDOUT, STDERR], $pipes);
        exit(proc_close($proc));
    }
}

if (in_array(end($argv), ['--tag', '--tag-add', '--tag-remove', '--tag-set'], true)) fail('Tag option needs a value');

if (end($argv) === '--waiting-on') {
    fail('--waiting-on needs SESSION[,SESSION] or none');
}

if (end($argv) === '--replaces') {
    fail('--replaces needs the source session');
}

$opts = getopt('h', $longOptions, $restIndex);

if ($opts === false) {
    fail("bad options\n\n" . usage());
}

if (isset($opts['h']) || isset($opts['help'])) {
    echo usage();
    exit(0);
}

$positional = array_slice($argv, $restIndex);

/** One scalar string option, or null. */
$opt = static function (string $name) use ($opts): ?string {
    $value = $opts[$name] ?? null;

    if (is_array($value)) {
        fail("--{$name} given more than once");
    }

    return is_string($value) && $value !== '' ? $value : null;
};

$prompt = implode(' ', $positional);

if ($prompt === '-') {
    $prompt = (string)stream_get_contents(STDIN);
}

$resume = $opt('resume');
$workdir = $opt('workdir') ?? ($resume === null ? getcwd() : null);

if ($workdir !== null && $workdir[0] !== '/') {
    $real = realpath($workdir);
    $workdir = $real !== false ? $real : $workdir;
}

if (getenv('SESSIONEER_AGENT_SOCKET') === false || getenv('SESSIONEER_AGENT_SOCKET') === '') {
    putenv('SESSIONEER_AGENT_SOCKET=' . (getenv('XDG_RUNTIME_DIR') ?: '/run/user/' . posix_getuid()) . '/sessioneer-agent.sock');
}

// A Codex session carries no SESSIONEER_SELF; its thread id is its session name.
$self = getenv('SESSIONEER_SELF') ?: getenv('CODEX_THREAD_ID') ?: null;

$tagValues = [];
try {
    foreach ((array)($opts['tag'] ?? []) as $value) {
        $tagValues = array_values(array_unique(array_merge($tagValues, \HostAgent\Services\TagService::parse($value, true))));
    }
} catch (\InvalidArgumentException $e) { fail($e->getMessage()); }
$edits = array_values(array_filter(['tag-add', 'tag-remove', 'tag-set'], static fn ($key) => isset($opts[$key])));
if ($edits !== []) {
    if (count($edits) !== 1 || $prompt !== '') fail('Tag edits need one action and no prompt');
    foreach (array_keys($opts) as $key) {
        if (!in_array($key, [$edits[0], 'session', 'json'], true)) fail('Tag edits cannot be combined with --' . $key);
    }
    $value = $opts[$edits[0]];
    if (!is_string($value)) fail('Tag edit needs a list');
    try {
        $tags = $edits[0] === 'tag-set' && $value === 'none' ? [] : \HostAgent\Services\TagService::parse($value, true);
        if ($tags === [] && !($edits[0] === 'tag-set' && $value === 'none')) fail('Tag edit needs a list');
        \HostAgent\Services\TagService::apply([], 'set', $tags);
    } catch (\InvalidArgumentException $e) { fail($e->getMessage()); }
    $session = $opt('session') ?? $self;
    if ($session === null) fail('Tag edit needs a session');
    $reply = AgentClient::agent_call(['action' => 'tags_set', 'session' => $session, 'mode' => substr($edits[0], 4), 'tags' => $tags]);
    if (isset($opts['json'])) echo json_encode($reply, JSON_UNESCAPED_SLASHES), "\n";
    if (($reply['ok'] ?? false) !== true) fail((string)($reply['error'] ?? $reply['message'] ?? 'Tag edit failed'));
    if (!isset($opts['json'])) echo 'tags: ', empty($reply['tags']) ? 'none' : implode(', ', $reply['tags']), "\n";
    exit(0);
}
if (isset($opts['tag'])) {
    foreach (['whoami', 'kill', 'send', 'show', 'answer', 'interrupt', 'wake', 'wake-list', 'wake-cancel', 'bare', 'take-over', 'session', 'next', 'offer', 'reap', 'usage', 'waiting-on'] as $other) {
        if (isset($opts[$other])) fail('--tag cannot be combined with --' . $other);
    }
    if (!isset($opts['list']) && !isset($opts['peers']) && !isset($opts['spawned']) && count($tagValues) > \HostAgent\Services\TagService::MAX_TAGS) fail('A session may have at most ' . \HostAgent\Services\TagService::MAX_TAGS . ' tags');
}

if (isset($opts['whoami'])) {
    if ($self === null) {
        fail('not running inside a Sessioneer session (neither SESSIONEER_SELF nor CODEX_THREAD_ID is set)');
    }

    if (isset($opts['json'])) {
        $identity = AgentClient::agent_call(['action' => 'launch_whoami', 'session' => $self]);
        if (($identity['ok'] ?? false) !== true) fail((string)($identity['error'] ?? $identity['message'] ?? 'Session not found'));
        echo json_encode(['name' => $identity['name'], 'conversation_id' => $identity['conversation_id'], 'tags' => $identity['tags']], JSON_UNESCAPED_SLASHES), "\n";
    } else echo $self, "\n";
    exit(0);
}

if (isset($opts['waiting-on'])) {
    $session = $opt('session') ?? $self;
    $given = $opts['waiting-on'];

    foreach (array_keys($opts) as $other) {
        if (!in_array($other, ['waiting-on', 'session', 'json'], true)) {
            fail(in_array($other, ['list', 'wake-list', 'wake-cancel', 'rotate', 'next', 'offer', 'usage', 'resets', 'schedule-reset', 'kill', 'send', 'peers', 'show', 'answer', 'interrupt', 'bare', 'take-over', 'set-name', 'spawned', 'reap', 'whoami', 'wake'], true)
                ? "--waiting-on cannot be combined with --{$other}"
                : "--{$other} does not apply to --waiting-on");
        }
    }

    if ($prompt !== '') {
        fail('--waiting-on takes no prompt');
    }

    if (!is_string($given) || $given === '') {
        fail('--waiting-on needs SESSION[,SESSION] or none');
    }

    $targets = [];

    if ($given !== 'none') {
        foreach (explode(',', $given) as $name) {
            $name = trim($name);

            if (preg_match('/^[A-Za-z0-9._-]+$/D', $name) !== 1 || $name === 'none') {
                fail('--waiting-on: invalid session name "' . $name . '" (letters, digits, dot, dash and underscore only)');
            }

            if ($name === $session) {
                fail('--waiting-on: a session cannot wait on itself');
            }

            $targets[] = $name;
        }

        if (count($targets) > 8) {
            fail('--waiting-on: at most 8 sessions');
        }

        $repeated = array_keys(array_filter(array_count_values($targets), static fn (int $n): bool => $n > 1));

        if ($repeated !== []) {
            fail('--waiting-on: duplicate session ' . $repeated[0]);
        }
    }

    if ($session === null) {
        fail('--waiting-on needs a calling Sessioneer session (neither SESSIONEER_SELF nor CODEX_THREAD_ID is set); name one with --session');
    }

    $reply = AgentClient::agent_call(['action' => 'waiting_on_set', 'session' => $session, 'targets' => $targets]);
    $done = ($reply['ok'] ?? false) === true;

    if (isset($opts['json'])) {
        echo json_encode($reply, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
    } elseif ($done) {
        $names = array_map('strval', (array)($reply['waiting_on'] ?? []));
        echo 'waiting on: ', $names === [] ? 'none' : implode(', ', $names), "\n";
    }

    if (!$done && !isset($opts['json'])) {
        fail((string)($reply['message'] ?? 'waiting-on failed'));
    }

    exit($done ? 0 : 1);
}

if (isset($opts['replaces'])) {
    if (!is_string($opts['replaces']) || trim($opts['replaces']) === '') {
        fail('--replaces needs the source session');
    }
}

if (isset($opts['replaces']) && $prompt === '') {
    foreach (array_keys($opts) as $other) {
        if (!in_array($other, ['replaces', 'session', 'json'], true)) {
            fail("--replaces cannot be combined with --{$other}");
        }
    }

    $receiver = $opt('session') ?? $self;

    if ($receiver === null) {
        fail('--replaces needs a calling Sessioneer session (neither SESSIONEER_SELF nor CODEX_THREAD_ID is set); name one with --session');
    }

    $reply = AgentClient::agent_call(['action' => 'flow_replaces', 'receiver' => $receiver, 'source' => $opts['replaces']]);
    $done = ($reply['ok'] ?? false) === true;

    if (isset($opts['json'])) {
        echo json_encode($reply, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
    } elseif ($done) {
        echo 'replaces ', $opts['replaces'], ': ', $reply['outcome'] ?? 'unknown', ' (', $reply['detail'] ?? '', ")\n";
    } else {
        fail((string)($reply['message'] ?? 'replaces failed'));
    }

    exit($done ? 0 : 1);
}

/** Digits-only Dibs id given to a flow option, or null when the option is absent. */
$flowId = static function (string $name) use ($opts): ?string {
    if (!isset($opts[$name])) {
        return null;
    }

    if (!is_string($opts[$name]) || !ctype_digit($opts[$name])) {
        fail("--{$name} must be a Dibs id, digits only");
    }

    return $opts[$name];
};

$quotaCommand = isset($opts['resets']) ? 'resets' : (isset($opts['schedule-reset']) ? 'schedule-reset' : null);

if (isset($opts['approve']) && !isset($opts['schedule-reset'])) {
    fail('--approve only applies to --schedule-reset');
}

if ($quotaCommand !== null) {
    if (isset($opts['resets'], $opts['schedule-reset'])) {
        fail('--resets and --schedule-reset cannot be combined');
    }

    $flag = '--' . $quotaCommand;
    $allowed = $quotaCommand === 'resets' ? ['resets', 'json'] : ['schedule-reset', 'approve', 'wake', 'handoff', 'plan', 'workdir', 'json'];

    foreach (array_keys($opts) as $given) {
        if (!in_array($given, $allowed, true)) {
            fail(in_array($given, ['list', 'wake-list', 'wake-cancel', 'rotate', 'next', 'offer', 'usage', 'resets', 'schedule-reset', 'kill', 'send', 'peers', 'show', 'answer', 'interrupt', 'bare', 'take-over', 'session', 'spawned', 'reap'], true)
                ? "{$flag} cannot be combined with --{$given}"
                : "--{$given} does not apply to {$flag}");
        }
    }

    if ($prompt !== '') {
        fail("{$flag} takes no prompt");
    }

    $stored = AgentClient::agent_call(['action' => 'flow_resets']);

    if ($quotaCommand === 'resets') {
        if (($stored['ok'] ?? false) !== true) {
            fail((string)($stored['message'] ?? 'resets unavailable'));
        }

        date_default_timezone_set(\HostAgent\Services\SessionWakeService::system_timezone());

        if (isset($opts['json'])) {
            echo json_encode($stored, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
            exit(0);
        }

        foreach ($stored['agents'] ?? [] as $agentKey => $entry) {
            foreach ($entry['profiles'] ?? [] as $profileKey => $profileEntry) {
                $at = $profileEntry['reset_at'] ?? null;
                echo implode("\t", [(string)$agentKey, (string)$profileKey, is_int($at) ? date('Y-m-d H:i T', $at) : 'unknown']), "\n";
            }
        }

        exit(0);
    }

    $target = (string)$opts['schedule-reset'];
    $parts = explode(':', $target);
    $scheduleAgent = $parts[0];
    $scheduleProfile = $parts[1] ?? null;

    if (count($parts) > 2 || $scheduleAgent === '' || $scheduleProfile === '') {
        fail('--schedule-reset takes AGENT or AGENT:PROFILE, both non-empty');
    }

    if (!isset($opts['approve'])) {
        fail('--schedule-reset queues a job only with --approve; nothing was queued');
    }

    $wakeTarget = $opt('wake');
    $handoff = $flowId('handoff');
    $plan = $flowId('plan');

    if (count(array_filter([$wakeTarget, $handoff, $plan], static fn (?string $v): bool => $v !== null)) !== 1) {
        fail('--schedule-reset needs exactly one of --wake TARGET, --handoff ID or --plan ID');
    }

    $scheduleWorkdir = $opt('workdir');

    if ($scheduleWorkdir !== null && $wakeTarget !== null) {
        fail('--workdir applies only to a fresh start (--handoff or --plan)');
    }

    if ($scheduleWorkdir !== null && $scheduleWorkdir[0] !== '/') {
        $real = realpath($scheduleWorkdir);
        $scheduleWorkdir = $real !== false ? $real : $scheduleWorkdir;
    }

    if (($stored['ok'] ?? false) !== true) {
        fail((string)($stored['message'] ?? 'resets unavailable'));
    }

    $profiles = $stored['agents'][$scheduleAgent]['profiles'] ?? null;

    if (!is_array($profiles)) {
        fail("Unknown agent {$scheduleAgent}");
    }

    if ($scheduleProfile === null && count($profiles) === 1) {
        $scheduleProfile = (string)array_key_first($profiles);
    }

    if ($scheduleProfile === null) {
        fail("--schedule-reset {$scheduleAgent} needs a profile: " . implode(', ', array_map('strval', array_keys($profiles))));
    }

    if (!array_key_exists($scheduleProfile, $profiles)) {
        fail("Unknown profile {$scheduleProfile} for {$scheduleAgent} (known: " . implode(', ', array_map('strval', array_keys($profiles))) . ')');
    }

    $resetAt = $profiles[$scheduleProfile]['reset_at'] ?? null;

    if (!is_int($resetAt)) {
        fail("No quota reset time is known for {$scheduleAgent}:{$scheduleProfile}; nothing was queued");
    }

    $reply = AgentClient::agent_call(array_filter([
        'action' => 'flow_schedule', 'agent' => $scheduleAgent, 'profile' => $scheduleProfile, 'approved' => true,
        'expected_reset_at' => $resetAt, 'session' => $wakeTarget, 'handoff_id' => $handoff, 'plan_id' => $plan, 'workdir' => $scheduleWorkdir,
    ], static fn ($v): bool => $v !== null));

    if (($reply['ok'] ?? false) !== true) {
        fail((string)($reply['message'] ?? 'schedule failed'));
    }

    if (isset($opts['json'])) {
        echo json_encode($reply, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
    } else {
        date_default_timezone_set(\HostAgent\Services\SessionWakeService::system_timezone());
        echo (!empty($reply['existing']) ? 'Already scheduled: job ' : 'Scheduled job ') . (int)$reply['job'] . ' for ' . date('Y-m-d H:i T', (int)($reply['at'] ?? $resetAt)) . "\n";
    }

    exit(0);
}

$flowCommands = array_values(array_filter(['next', 'rotate', 'offer'], static fn (string $c): bool => isset($opts[$c])));
$flowModifiers = [
    'intent' => ['next'], 'post' => ['next'], 'no-gates' => ['next'], 'all' => ['next'], 'prompt' => ['rotate'], 'dry-run' => ['rotate'], 'clear' => ['offer'],
    'plan' => ['next', 'rotate', 'offer'], 'handoff' => ['next', 'rotate', 'offer'],
];

if (count($flowCommands) > 1) {
    fail('--next, --rotate and --offer cannot be combined');
}

foreach ($flowModifiers as $modifier => $commands) {
    if (isset($opts[$modifier]) && ($flowCommands === [] || !in_array($flowCommands[0], $commands, true))) {
        fail("--{$modifier} only applies to --" . implode(', --', $commands));
    }
}

if ($flowCommands !== []) {
    $command = $flowCommands[0];

    foreach (['kill', 'list', 'send', 'peers', 'usage', 'show', 'answer', 'interrupt', 'wake', 'wake-list', 'wake-cancel', 'bare', 'take-over', 'session', 'resume', 'wait', 'spawned', 'reap'] as $other) {
        if (isset($opts[$other])) {
            fail("--{$command} cannot be combined with --{$other}");
        }
    }

    if ($command !== 'rotate') {
        foreach (['agent', 'model', 'effort', 'profile', 'workdir', 'set-name'] as $launchOption) {
            if (isset($opts[$launchOption])) {
                fail("--{$launchOption} only applies to --rotate");
            }
        }
    }

    $handoff = $flowId('handoff');
    $plan = $flowId('plan');
    $text = $command === 'offer' ? ($prompt === '' ? null : $prompt) : (isset($opts['prompt']) ? (string)$opts['prompt'] : null);

    if ($text !== null && (trim($text) === '' || strlen($text) > 8000)) {
        fail($command === 'offer' ? 'the offer PROMPT must be 1 to 8000 characters' : '--prompt must be 1 to 8000 characters');
    }

    if ($command !== 'offer' && count($positional) > 1) {
        fail("--{$command} takes one TARGET at most");
    }

    $target = $command === 'offer' ? null : ($positional[0] ?? null);
    $sources = count(array_filter([$handoff, $plan, $text], static fn (?string $v): bool => $v !== null));

    if ($command === 'next' && $handoff !== null && $plan !== null) {
        fail('--handoff and --plan cannot be combined');
    }

    if ($command === 'next' && isset($opts['all']) && $target !== null) {
        fail('--all cannot be combined with a TARGET');
    }

    if ($command === 'next' && isset($opts['intent']) && !in_array($opts['intent'], ['step-end', 'wait', 'done'], true)) {
        fail('--intent must be step-end, wait or done');
    }

    if ($command === 'rotate' && $sources !== 1) {
        fail('--rotate needs exactly one of --handoff, --plan or --prompt');
    }

    if ($command === 'offer' && isset($opts['clear']) && $sources > 0) {
        fail('--clear cannot be combined with --handoff, --plan or a PROMPT');
    }

    if ($command === 'offer' && !isset($opts['clear']) && $sources !== 1) {
        fail('--offer needs exactly one of --handoff, --plan or a PROMPT, or --clear');
    }

    if (($command === 'offer' || $target === null && !isset($opts['all'])) && $self === null) {
        fail('not running inside a Sessioneer session (neither SESSIONEER_SELF nor CODEX_THREAD_ID is set); name a TARGET');
    }

    $reply = AgentClient::agent_call(array_filter(match ($command) {
        'next' => [
            'action' => 'flow_next', 'session' => isset($opts['all']) ? null : ($target ?? $self), 'all' => isset($opts['all']) ? true : null,
            'intent' => $opts['intent'] ?? null, 'plan_id' => $plan, 'handoff_id' => $handoff, 'post' => isset($opts['post']) ? true : null,
            'no_gates' => isset($opts['no-gates']) ? true : null,
        ],
        'rotate' => [
            'action' => 'flow_rotate', 'session' => $target ?? $self, 'plan_id' => $plan, 'handoff_id' => $handoff, 'prompt' => $text,
            'agent' => $opt('agent'), 'model' => $opt('model'), 'effort' => $opt('effort'), 'profile' => $opt('profile'),
            'workdir' => $opt('workdir'), 'set_name' => $opt('set-name'), 'tags' => isset($opts['tag']) ? $tagValues : null, 'dry_run' => isset($opts['dry-run']) ? true : null,
        ],
        default => ['action' => isset($opts['clear']) ? 'flow_offer_dismiss' : 'flow_offer', 'self' => $self, 'plan_id' => $plan, 'handoff_id' => $handoff, 'prompt' => $text],
    }, static fn ($v): bool => $v !== null));

    if (($reply['ok'] ?? false) !== true) {
        fail((string)($reply['message'] ?? "{$command} failed"));
    }

    foreach ($reply['warnings'] ?? [] as $warning) {
        fwrite(STDERR, "sessioneer: {$warning}\n");
    }

    if (isset($opts['json'])) {
        echo json_encode($reply, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
    } elseif ($command === 'next') {
        foreach ($reply['sessions'] ?? [$reply + ['name' => null]] as $row) {
            echo implode("\t", array_filter([$row['name'], $row['state'], $row['why'], is_array($row['receiver'] ?? null) ? $row['receiver']['key'] : ($row['receiver'] ?? null), $row['prompt_kind'] ?? null], static fn ($v): bool => $v !== null)), "\n";
        }

        if (!empty($reply['offer'])) {
            echo "offer posted: {$reply['offer']['source']}\n";
        }

        if (($reply['auto_continued'] ?? false) === true) {
            echo 'auto-continued: ', (string)($reply['session'] ?? ''), "\n";
        }
    } elseif ($command === 'rotate') {
        if (!empty($reply['dry_run'])) {
            echo 'Receiver: ', implode('/', array_filter([$reply['launch']['agent'] ?? null, $reply['launch']['profile'] ?? null])), "\n", (string)($reply['prompt'] ?? ''), "\n";
        } else {
            echo (string)$reply['session'], "\n";
        }
    } else {
        echo isset($opts['clear']) ? "offer dismissed\n" : "offer posted\n";
    }

    exit(0);
}

$kill = $opt('kill');
$list = isset($opts['list']);
$send = $opt('send');
$peers = isset($opts['peers']);
$spawned = isset($opts['spawned']);
$reap = isset($opts['reap']);
$show = $opt('show');
$answer = $opt('answer');
$interrupt = $opt('interrupt');
$wake = $opt('wake');
$wakeList = isset($opts['wake-list']);
$wakeCancelGiven = isset($opts['wake-cancel']);
$wakeCancel = $opt('wake-cancel');
$bare = isset($opts['bare']);
$takeOver = $opt('take-over');
$setName = $opt('set-name');
$sessionTarget = $opt('session');

if (isset($opts['set-name']) && $setName === null) {
    fail('--set-name needs a name');
}

// Every action that is not a launch or a resume.
$nonLaunch = $kill !== null || $list || $send !== null || $peers || $show !== null || $answer !== null || $interrupt !== null || $wake !== null || $wakeList || $wakeCancelGiven || $bare || $takeOver !== null || $sessionTarget !== null || $spawned || $reap;

if ($sessionTarget !== null && ($setName === null || $prompt !== '' || $resume !== null || $kill !== null || $list || $send !== null || $peers || $show !== null || $answer !== null || $interrupt !== null || $wake !== null || $wakeList || $wakeCancelGiven || $bare || $takeOver !== null || isset($opts['usage']) || isset($opts['wait']))) {
    fail('--session needs --set-name, and renames that session only: no prompt and no other action');
}

if ($setName !== null && $sessionTarget === null && $nonLaunch) {
    fail('--set-name names the session a launch or resume starts; use --session TARGET to rename an existing one');
}

if (count(array_filter([$kill !== null, $list, $send !== null, $peers, isset($opts['usage']), $show !== null, $answer !== null, $interrupt !== null, $wake !== null, $wakeList, $wakeCancelGiven, $bare, $takeOver !== null])) > 1) {
    fail('--kill, --list, --show, --answer, --interrupt, --wake, --wake-list, --wake-cancel, --bare, --take-over, --send, --peers and --usage cannot be combined');
}

if ($spawned || $reap) {
    $flag = $reap ? '--reap' : '--spawned';

    if ($spawned && $reap || $nonLaunch && ($kill !== null || $list || $send !== null || $peers || $show !== null || $answer !== null || $interrupt !== null || $wake !== null || $wakeList || $wakeCancelGiven || $bare || $takeOver !== null || $sessionTarget !== null) || isset($opts['usage'])) {
        fail('--spawned and --reap cannot be combined with each other or with another action');
    }

    foreach (['agent', 'model', 'profile', 'workdir', 'task-tools', 'timeout'] as $stray) {
        if (isset($opts[$stray])) {
            fail("--{$stray} does not apply to {$flag}");
        }
    }

    if ($prompt !== '' || isset($opts['force']) || isset($opts['wait'])) {
        fail("{$flag} takes no prompt and never forces or waits");
    }

    if ($self === null) {
        fail("{$flag} needs a calling Sessioneer session (neither SESSIONEER_SELF nor CODEX_THREAD_ID is set)");
    }
}

// Modifiers belong to one action each; a stray one would otherwise be ignored.
foreach ([
    'history' => [$show !== null, '--history only applies to --show'],
    'option' => [$answer !== null, '--option only applies to --answer'],
    'text' => [$answer !== null, '--text only applies to --answer'],
    'answers' => [$answer !== null, '--answers only applies to --answer'],
    'expect' => [$answer !== null, '--expect only applies to --answer'],
    'expect-request' => [$answer !== null, '--expect-request only applies to --answer'],
    'as-user' => [$send !== null, '--as-user only applies to --send'],
    'at' => [$wake !== null, '--at only applies to --wake'],
] as $modifier => [$allowed, $message]) {
    if (isset($opts[$modifier]) && !$allowed) {
        fail($message);
    }
}

if ($resume !== null && $nonLaunch && $takeOver === null) {
    fail('--resume only applies to launching a session or to --take-over');
}

if ($wakeCancelGiven && ($wakeCancel === null || preg_match('/^[1-9][0-9]*$/', $wakeCancel) !== 1)) {
    fail('--wake-cancel needs an at job number');
}

if (($wakeList || $wakeCancelGiven) && $prompt !== '') {
    fail('--wake-list and --wake-cancel take no prompt');
}

$wakeAt = null;

if ($wake !== null) {
    // PHP defaults to UTC; "18:30" means the machine's clock, the same one `at` reads.
    date_default_timezone_set(\HostAgent\Services\SessionWakeService::system_timezone());
    $atText = $opt('at');
    $wakeAt = $atText === null ? false : strtotime($atText);

    if ($wakeAt === false) {
        fail($atText === null ? '--wake needs --at TIME' : "--at '{$atText}' is not a time I can read");
    }

    if (trim($prompt) === '') {
        $prompt = 'continue';
    }
}

$history = $opt('history');

if ($history !== null && (!ctype_digit($history) || (int)$history < 1)) {
    fail('--history must be a positive number of entries');
}

$answerPayload = [];

if ($answer !== null) {
    $optionNumber = $opt('option');
    $answersJson = $opt('answers');

    if (($optionNumber === null) === ($answersJson === null)) {
        fail('--answer needs exactly one of --option N or --answers JSON');
    }

    if ($optionNumber !== null && (!ctype_digit($optionNumber) || (int)$optionNumber < 1)) {
        fail('--option must be a positive option number');
    }

    if ($answersJson !== null) {
        $decoded = json_decode($answersJson === '-' ? (string)stream_get_contents(STDIN) : $answersJson, true);

        if (!is_array($decoded) || $decoded === []) {
            fail('--answers must be a non-empty JSON list, one entry per question');
        }

        if ($opt('text') !== null || $opt('expect') !== null) {
            fail('--text and --expect go with --option, not --answers');
        }

        $answerPayload = ['answers' => $decoded, 'expected_request_id' => $opt('expect-request')];
    } else {
        $answerPayload = ['option' => (int)$optionNumber, 'text' => $opt('text'), 'expected_label' => $opt('expect'), 'expected_request_id' => $opt('expect-request')];
    }
}

if (isset($opts['usage'])) {
    $reply = AgentClient::agent_call(['action' => 'quota']);

    if (!isset($reply['agents'], $reply['claude_profiles'])) {
        fail((string)($reply['message'] ?? 'usage unavailable'));
    }

    // One shape for every agent: label plus profiles.<name>. An agent with a single account is profiles.default;
    // a top-level quota is never exposed because it cannot say which account it belongs to.
    $agents = [];
    foreach ($reply['agents'] as $key => $agent) {
        $profiles = $key === 'claude'
            ? $reply['claude_profiles']
            : ['default' => array_diff_key($agent, ['label' => 1])];
        $agents[$key] = ['label' => $agent['label'] ?? $key, 'profiles' => $profiles];
    }

    echo json_encode(['agents' => $agents], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
    exit(0);
}

if (isset($opts['no-tools'])) {
    if ($resume !== null || $nonLaunch) {
        fail('--no-tools only applies to starting a new session');
    }

    if (isset($opts['task-tools'])) {
        fail('--no-tools and --task-tools cannot be combined');
    }
}

foreach (['allowed-tools', 'disallowed-tools'] as $toolOption) {
    if (isset($opts[$toolOption])) {
        if (is_string($opts[$toolOption]) && trim($opts[$toolOption]) === '') {
            fail("--{$toolOption} needs a non-empty list");
        }

        if ($resume !== null || $nonLaunch) {
            fail("--{$toolOption} only applies to starting a new session");
        }

        if (isset($opts['no-tools'])) {
            fail("--{$toolOption} and --no-tools cannot be combined: --no-tools already removes every tool");
        }
    }
}

if ($opt('effort') !== null && $nonLaunch) {
    fail('--effort only applies to launching or resuming a session');
}

// An Ollama session is a local model reached over Sessioneer's own HTTP
// client: no account, no reasoning levels, no permission modes, no tools.
if ($opt('agent') === 'ollama') {
    foreach ([
        'profile' => '--profile has no meaning for --agent ollama: a local model runs under no account',
        'effort' => '--effort has no meaning for --agent ollama: a local model has no reasoning levels',
        'mode' => '--mode has no meaning for --agent ollama: its sessions have no permission modes',
        'no-tools' => '--no-tools has no meaning for --agent ollama: its sessions never have tools',
        'task-tools' => '--task-tools has no meaning for --agent ollama: its sessions never have tools',
        'allowed-tools' => '--allowed-tools has no meaning for --agent ollama: its sessions never have tools',
        'disallowed-tools' => '--disallowed-tools has no meaning for --agent ollama: its sessions never have tools',
    ] as $option => $message) {
        if (isset($opts[$option])) {
            fail($message);
        }
    }
}

// An OpenCode session is a serve-hosted conversation: no account profile,
// reasoning-level control, permission-mode vocabulary or tool-set flags.
if ($opt('agent') === 'opencode') {
    foreach ([
        'profile' => '--profile has no meaning for --agent opencode: its serve sessions have no account profile',
        'effort' => '--effort has no meaning for --agent opencode: the serve has no reasoning-level control',
        'mode' => '--mode has no meaning for --agent opencode: its sessions have no permission modes',
        'no-tools' => '--no-tools has no meaning for --agent opencode: the serve session\'s tools are not configurable here',
        'task-tools' => '--task-tools has no meaning for --agent opencode: the serve session\'s tools are not configurable here',
        'allowed-tools' => '--allowed-tools has no meaning for --agent opencode: the serve session\'s tools are not configurable here',
        'disallowed-tools' => '--disallowed-tools has no meaning for --agent opencode: the serve session\'s tools are not configurable here',
    ] as $option => $message) {
        if (isset($opts[$option])) {
            fail($message);
        }
    }
}

// Validated before the request: a bad --timeout used to be caught after the
// launch, which left the session it had just created running.
if (isset($opts['wait'])) {
    if ($nonLaunch) {
        fail('--wait only applies to launching or resuming a session');
    }

    $timeout = $opt('timeout');

    if ($timeout !== null && (!ctype_digit($timeout) || (int)$timeout < 1)) {
        fail('--timeout must be a positive number of seconds');
    }

    // --wait only follows a launch. A session name given as the prompt would start a new
    // session whose whole prompt is that name, so refuse it before anything is launched.
    if ($prompt !== '' && $resume === null) {
        $named = AgentClient::agent_call(['action' => 'launch_show', 'target' => $prompt]);

        if (($named['ok'] ?? false) === true) {
            fail("'{$prompt}' is an existing session, not a prompt. --wait starts a new session; read it with --show {$prompt}");
        }
    }
}

$action = match (true) {
    $sessionTarget !== null => 'launch_set_name',
    $kill !== null => 'launch_kill',
    $list => 'launch_list',
    $send !== null => 'launch_send',
    $peers => 'launch_peers',
    $spawned => 'launch_spawned',
    $reap => 'launch_reap',
    $show !== null => 'launch_show',
    $answer !== null => 'launch_answer',
    $interrupt !== null => 'launch_interrupt',
    $wake !== null => 'launch_wake',
    $wakeList => 'launch_wake_list',
    $wakeCancelGiven => 'launch_wake_cancel',
    $bare => 'launch_bare',
    $takeOver !== null => 'launch_take_over',
    default => 'launch',
};

$reply = AgentClient::agent_call(array_filter([
    'action' => $action,
    'tags' => $action === 'launch' && isset($opts['tag']) ? $tagValues : null,
    'tag_filter' => in_array($action, ['launch_list', 'launch_peers', 'launch_spawned'], true) && isset($opts['tag']) ? $tagValues : null,
    'agent' => $opt('agent'),
    'prompt' => $prompt,
    'agent_session_id' => $resume,
    'workdir' => $takeOver !== null || $sessionTarget !== null ? null : $workdir,
    'model' => $opt('model'),
    'effort' => $opt('effort'),
    'starting_mode' => $opt('mode'),
    'profile' => $opt('profile'),
    'caller_config_dir' => $opt('profile') === null ? (getenv('CLAUDE_CONFIG_DIR') ?: null) : null,
    'enable_task_tools' => isset($opts['task-tools']) ? true : null,
    'no_tools' => isset($opts['no-tools']) ? true : null,
    'allowed_tools' => $opt('allowed-tools'),
    'disallowed_tools' => $opt('disallowed-tools'),
    'target' => $kill ?? $send ?? $show ?? $answer ?? $interrupt ?? $wake ?? $takeOver ?? $sessionTarget,
    'set_name' => $setName,
    'message' => $send !== null || $wake !== null ? $prompt : null,
    'at' => $wakeAt,
    'job' => $wakeCancel !== null ? (int)$wakeCancel : null,
    'include_prompt' => $wakeList && isset($opts['json']) ? true : null,
    'from' => $send !== null || $peers || $answer !== null || $wake !== null || $wakeCancelGiven || $spawned || $reap || $action === 'launch' ? $self : null,
    'force' => isset($opts['force']) ? true : null,
    'as_user' => isset($opts['as-user']) ? true : null,
    'history' => $history !== null ? (int)$history : null,
] + $answerPayload, static fn ($v): bool => $v !== null && $v !== ''));

$ok = ($reply['ok'] ?? false) === true;
if (isset($reply['tags_error'])) fwrite(STDERR, (string)$reply['tags_error'] . "\n");

if ($ok && $action === 'launch' && isset($opts['replaces']) && is_string($reply['name'] ?? null)) {
    $link = AgentClient::agent_call(['action' => 'flow_replaces', 'receiver' => $reply['name'], 'source' => $opts['replaces'], 'launched' => true]);
    if (($link['ok'] ?? false) !== true) fwrite(STDERR, '--replaces ' . $opts['replaces'] . ': ' . (string)($link['message'] ?? 'failed') . "\n");
}

if (isset($opts['wait'])) {
    $json = isset($opts['json']);
    $agentName = $opt('agent') ?? 'claude';
    $modelName = $opt('model');

    // Fails a --wait run without breaking the JSON contract: the envelope goes
    // to stdout when it was asked for, the human message to stderr, exit 1
    // either way.
    $waitFail = static function (string $kind, string $message, ?string $session, ?array $detail = null) use ($json, $agentName, $modelName, $workdir): never {
        if ($json) {
            emit_envelope(wait_envelope(
                false,
                null,
                $session,
                is_string($detail['agent_session_id'] ?? null) ? $detail['agent_session_id'] : null,
                is_string($detail['agent'] ?? null) ? $detail['agent'] : $agentName,
                $modelName,
                is_string($detail['workdir'] ?? null) ? $detail['workdir'] : $workdir,
                ['kind' => $kind, 'message' => $message],
            ));
        }

        fail($message);
    };

    if (!$ok) {
        $waitFail('launch_refused', (string)($reply['message'] ?? 'launch failed'), is_string($reply['name'] ?? null) ? $reply['name'] : null);
    }

    $name = (string)($reply['name'] ?? '');
    $timeout = $opt('timeout');
    $deadline = $timeout !== null ? time() + (int)$timeout : null;
    fwrite(STDERR, $name . "\n");

    // The launch reply is only sent once the prompt was accepted, so the turn
    // has started; idle after that means it finished.
    $detail = null;

    while (true) {
        $d = AgentClient::agent_call(['action' => 'session_detail', 'session' => $name]);

        if (($d['ok'] ?? false) !== true) {
            $waitFail('session_error', 'session ' . $name . ': ' . (string)($d['message'] ?? 'detail unavailable'), $name, $detail);
        }

        $detail = $d;

        if (is_string($d['last_turn_error'] ?? null) && $d['last_turn_error'] !== '') {
            $waitFail('turn_error', 'session ' . $name . ' errored: ' . $d['last_turn_error'], $name, $detail);
        }

        // A new Codex thread reports idle for a few seconds after its prompt is accepted, before the
        // turn goes active; only an assistant reply as the last message proves the turn happened.
        $replied = $opt('agent') !== 'codex' || ($d['last_message']['role'] ?? null) === 'assistant';

        if ($replied && (($d['status'] ?? null) === 'idle' || (!isset($d['status']) && empty($d['working'])))) {
            $text = [];

            foreach ($d['last_message']['blocks'] ?? [] as $b) {
                if (($b['kind'] ?? null) === 'text') {
                    $text[] = (string)$b['text'];
                }
            }

            $answer = implode("\n\n", $text);

            if ($json) {
                emit_envelope(wait_envelope(
                    true,
                    $answer,
                    $name,
                    is_string($d['agent_session_id'] ?? null) ? $d['agent_session_id'] : null,
                    is_string($d['agent'] ?? null) ? $d['agent'] : $agentName,
                    $modelName,
                    is_string($d['workdir'] ?? null) ? $d['workdir'] : $workdir,
                    null,
                ));
            } else {
                echo $answer, "\n";
            }

            exit(0);
        }

        if ($deadline !== null && time() >= $deadline) {
            $waitFail('timeout', 'timed out after ' . $timeout . 's waiting for ' . $name, $name, $detail);
        }

        sleep(2);
    }
}

if (isset($opts['json'])) {
    echo json_encode($reply, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
} elseif ($ok && $list) {
    foreach ($reply['sessions'] ?? [] as $s) {
        echo implode("\t", [(string)$s['name'], (string)$s['status'], (string)($s['agent_session_id'] ?? '-'), (string)($s['workdir'] ?? '-'), implode(', ', $s['tags'] ?? [])]), "\n";
    }
} elseif ($ok && $wakeList) {
    foreach ($reply['wakes'] ?? [] as $w) {
        echo implode("\t", [(string)$w['job'], (string)$w['at_local'], (string)$w['state'], (string)($w['session'] ?? '-'), (string)$w['agent_session_id'], (string)$w['prompt_preview']]), "\n";
    }
} elseif ($ok && $show !== null) {
    echo show_text($reply);
    if (!empty($reply['tags'])) echo 'tags: ', implode(', ', $reply['tags']), "\n";
} elseif ($ok && $bare) {
    foreach ($reply['bare'] ?? [] as $b) {
        echo implode("\t", [(string)$b['pid'], (string)($b['resolved_agent_session_id'] ?? '-'), (string)($b['cwd'] ?? '-'), (string)($b['resolved_title'] ?? '-')]), "\n";
    }
} elseif ($ok && $takeOver !== null && ($reply['needs_choice'] ?? false) === true) {
    // Nothing was stopped: say which conversations it might be, and how to pick one.
    foreach ($reply['candidates'] ?? [] as $c) {
        echo implode("\t", [(string)($c['agent_session_id'] ?? '-'), (string)($c['title'] ?? '-')]), "\n";
    }

    fwrite(STDERR, 'sessioneer: cannot tell for certain which conversation pid ' . (string)($reply['pid'] ?? $takeOver) . " runs; nothing was stopped. Repeat with --resume ID to take over the right one"
        . (isset($reply['suggested_agent_session_id']) ? ' (suggested: ' . $reply['suggested_agent_session_id'] . ')' : '') . ".\n");
    exit(1);
} elseif ($ok && $peers) {
    foreach ($reply['peers'] ?? [] as $p) {
        echo implode("\t", [(string)$p['name'], (string)$p['status'], (string)($p['branch'] ?? '-'), (string)($p['workdir'] ?? '-'), implode(', ', $p['tags'] ?? [])]), "\n";
    }
} elseif ($ok) {
    echo (string)($reply['name'] ?? ''), "\n";
    fwrite(STDERR, (string)($reply['message'] ?? '') . "\n");
} else {
    fwrite(STDERR, 'sessioneer: ' . (string)($reply['message'] ?? 'launch failed') . "\n");
}

exit($ok ? 0 : 1);
