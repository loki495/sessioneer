# Fixture config for the test suite (tests/run.sh). No secrets - safe to
# commit. Mirrors host-agent/.env.example's variables, but points every
# host-specific path at an isolated fixture instead of the real host
# session, so tests can never touch real tmux sessions or spawn a real
# claude process. See tests/run.sh for how this is loaded and cleaned up.

# --- Fixture "claude" binary: behaves like `cat` (blocks on stdin, ignores
# its own argv - see the script itself for why), never the real CLI. Uses
# `exec -a "$0"` internally so argv[0] still ends up exactly this path, like
# a real installed launcher - required for find_claude_processes()'s
# argv[0] match in Sessions.php to work in tests. $SCRIPT_DIR is set by
# run.sh (this repo's own tests/ dir) before this file is sourced, so this
# resolves correctly regardless of where the repo is actually checked out.
CLAUDE_BIN=$SCRIPT_DIR/fixtures/fake_claude

# --- Fixture "agy" (Antigravity CLI) binary, same idea as CLAUDE_BIN above
# - see tests/fixtures/fake_agy for why it's a script, not a symlink. ---
ANTIGRAVITY_BIN=$SCRIPT_DIR/fixtures/fake_agy

# --- Fixture "opencode" TUI binary, same idea as CLAUDE_BIN/ANTIGRAVITY_BIN
# - see tests/fixtures/fake_opencode. ---
OPENCODE_BIN=$SCRIPT_DIR/fixtures/fake_opencode

# --- Fixture www root, not the real ~/www ---
WWW_ROOT=$SCRIPT_DIR/fixtures/www_root

# --- Fixture home root, one level up from WWW_ROOT - the folder browser
# must be able to walk up to here but never past it ---
HOME_ROOT=$SCRIPT_DIR/fixtures

# --- Isolated tmux socket = a completely separate tmux server, never the
# real one at /tmp/tmux-1000/default. tests/run.sh kill-servers this on
# exit (trap), which also kills every process it started. ---
TMUX_SOCKET=/tmp/sessioneer-test-tmux/socket

# --- Isolated sidecar dir, removed by tests/run.sh on exit ---
SIDECAR_DIR=/tmp/sessioneer-test-sidecars

# --- Isolated session-list cache dir, removed by tests/run.sh on exit -
# never the real host's /run/user/<uid>/sessioneer-cache ---
CACHE_DIR=/tmp/sessioneer-test-cache

# --- Off (0) for tests: SessionService::list_all_sessions() is called
# repeatedly in-process right after mutating actions (create/resume/kill)
# and must see fresh state every time, not a result cached from a moment
# a real poller's staleness tolerance would consider close enough. ---
SESSION_LIST_CACHE_TTL_SECONDS=0

# --- Pin the headless opencode serve at a dead port by default: the `list`
# action's headless sync (csm_headless_sync()) reads OPENCODE_SERVE_URL, so
# an unpinned default would hit the REAL serve at :4096 and adopt the host's
# own serve sessions into the fixture sidecar DB. Tests that need a real or
# stubbed serve set OPENCODE_SERVE_URL themselves. ---
OPENCODE_SERVE_URL=http://127.0.0.1:1

# --- Never enumerate/search the real host's OpenCode archive. Tests that
# need transcript rows point this at their own canned SQLite fixture. ---
OPENCODE_DB_PATH=/tmp/sessioneer-test-opencode-does-not-exist.db

# --- Never let quota/list synchronization reach the real Codex bridge. ---
CODEX_BRIDGE_SOCKET=/tmp/sessioneer-test-codex-bridge-does-not-exist.sock

# --- Short threshold so the cleanup test doesn't need to wait 12h ---
CLEANUP_THRESHOLD_SECONDS=2

# --- Fake systemd unit name for the push-check timer - set_push_timer_interval()
# runs real `systemctl --user is-active`/`restart` commands, so without this
# override a test on this same machine would query/restart the REAL
# production sessioneer-push-check.timer. A name systemd has never heard of makes
# is-active reliably report "inactive", which is what keeps the restart
# branch from ever firing in tests. ---
PUSH_TIMER_UNIT_NAME=sessioneer-test-fake-push-timer.timer

# --- Never reach the real Claude headless manager (socket) or query its real
# systemd unit from the health check. ---
CLAUDE_HEADLESS_SOCKET=/tmp/sessioneer-test-claude-headless-does-not-exist.sock
CLAUDE_HEADLESS_UNIT_NAME=sessioneer-test-fake-claude-headless.service
