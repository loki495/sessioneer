#!/bin/bash
# Stand-in for the real `agy` binary (see tests/.env.testing's
# ANTIGRAVITY_BIN). Two distinct behaviors, matching the two distinct real
# invocation shapes this app actually uses:
#
# - Interactive TUI spawn (create_agent_session(), no -p/--print flag) -
#   blocks on stdin forever, like an idle pane - same reasoning
#   tests/fixtures/fake_claude already has (real flags like --model/--mode
#   would trip up a plain coreutils binary otherwise). See that file's own
#   comment for why `exec -a` is used instead of a plain shebang.
# - Print/headless mode (-p/--print, e.g. host-agent/antigravity_quota_poll.php's
#   own `/usage` call) - runs once and exits, same as a real print-mode
#   invocation, with a canned JSON envelope matching the real `/usage`
#   response shape (confirmed live 2026-08-24, see
#   docs/history/antigravity-adapter-plan.md) - close enough for tests that only
#   care about the parsing/storage logic downstream, not the real numbers.
for arg in "$@"; do
    if [ "$arg" = "-p" ] || [ "$arg" = "--print" ]; then
        cat <<'JSON'
{"conversation_id":"","status":"SUCCESS","response":"Gemini Models\tWeekly Limit Remaining\t75%\n","duration_seconds":0,"num_turns":0,"usage":{"input_tokens":0,"output_tokens":0,"thinking_tokens":0,"cache_read_tokens":0,"total_tokens":0},"command":{"name":"usage","data":{"groups":[{"name":"Gemini Models","buckets":[{"id":"gemini-weekly","name":"Weekly Limit Remaining","window":"weekly","remaining_fraction":0.75,"reset_time":"2026-08-31T20:07:27Z"}]},{"name":"Claude and GPT models","buckets":[{"id":"3p-weekly","name":"Weekly Limit Remaining","window":"weekly","remaining_fraction":1,"reset_time":"2026-08-31T21:21:33Z"}]}]}}}
JSON
        exit 0
    fi
done

exec -a "$0" cat
