From: Sessioneer local fix
Subject: [PATCH] Fix provider model resolution across directories in serve mode

PROBLEM:
  The provider state is cached per-directory via InstanceState (ScopedCache
  keyed by directory). In serve mode, /config/providers and prompt_async
  resolve to different directories (serve cwd vs session directory), getting
  different cached provider states. Models visible in /config/providers are
  "not found" during prompt execution.

  The InstanceState cache at packages/opencode/src/effect/instance-state.ts
  uses ScopedCache.get(cache, directory) as the lookup key. Different
  directories => different cache entries => different provider init runs.

FIX:
  Add a fixedKey option to InstanceState.make. When set, get() uses this
  key instead of the directory, so all directories share one cached state.
  Only the provider init uses this; all other InstanceState consumers
  keep their per-directory behavior.

FILES MODIFIED:
  1. packages/opencode/src/effect/instance-state.ts  (add fixedKey plumbing)
  2. packages/opencode/src/provider/provider.ts       (use fixedKey: "provider-global")

--- a/packages/opencode/src/effect/instance-state.ts
+++ b/packages/opencode/src/effect/instance-state.ts
@@ -10,6 +10,7 @@ const TypeId = "~opencode/InstanceState"
 
 export interface InstanceState<A, E = never, R = never> {
   readonly [TypeId]: typeof TypeId
+  readonly _fixedKey?: string
   readonly cache: ScopedCache.ScopedCache<string, A, E, R>
 }
 
@@ -38,10 +39,14 @@ export const directory = Effect.map(context, (ctx) => ctx.directory)
 
 export const make = <A, E = never, R = never>(
   init: (ctx: InstanceContext) => Effect.Effect<A, E, R | Scope.Scope>,
+  options?: { fixedKey?: string },
 ): Effect.Effect<InstanceState<A, E, Exclude<R, Scope.Scope>>, never, R | Scope.Scope> =>
   Effect.gen(function* () {
     const cache = yield* ScopedCache.make<string, A, E, R>({
       capacity: Number.POSITIVE_INFINITY,
       lookup: () =>
         Effect.gen(function* () {
           return yield* init(yield* context)
         }),
     })
 
     const off = registerDisposer((directory) =>
       Effect.runPromise(ScopedCache.invalidate(cache, directory).pipe(Effect.provide(EffectLogger.layer))),
     )
     yield* Effect.addFinalizer(() => Effect.sync(off))
 
     return {
       [TypeId]: TypeId,
+      _fixedKey: options?.fixedKey,
       cache,
     }
   })
 
 export const get = <A, E, R>(self: InstanceState<A, E, R>) =>
   Effect.gen(function* () {
-    return yield* ScopedCache.get(self.cache, yield* directory)
+    const key = self._fixedKey ?? (yield* directory)
+    return yield* ScopedCache.get(self.cache, key)
   })
 
--- a/packages/opencode/src/provider/provider.ts
+++ b/packages/opencode/src/provider/provider.ts
@@ -1104,7 +1104,7 @@ export const layer = Layer.effect(
     const state = yield* InstanceState.make<State>(() =>
       Effect.gen(function* () {
         // ... existing init code unchanged ...
-      }),
+      }), { fixedKey: "provider-global" },
     )
 
     const list = Effect.fn("Provider.list")(() => InstanceState.use(state, (s) => s.providers))
