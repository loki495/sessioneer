{
    "name": "loki495/sessioneer",
    "description": "A self-hosted web UI for managing Claude Code, Codex, OpenCode, and Antigravity coding-agent sessions - see blocked prompts, answer them, send messages, view transcripts, all from a phone or any browser on your LAN.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo_sqlite": "*",
        "minishlink/web-push": "^9.0",
        "league/plates": "^3.6"
    },
    "autoload": {
        "psr-4": {
            "HostAgent\\": "host-agent/lib/",
            "App\\": "src/lib/"
        }
    },
    "authors": [
        {
            "name": "Andres Crucitti",
            "email": "andres@ac495.net"
        }
    ],
    "require-dev": {
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=1G"
    }
}
