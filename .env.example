# Copy to .env and fill in real values. Never commit .env.

# --- Host UID/GID for the container's non-root user ---
# APP_GID must match the group that owns the host agent's socket file
# (SocketGroup= in host-agent/systemd/sessioneer-agent.socket - host-agent/
# install.sh sets this to your own username; run `id -g` to find the
# matching gid) so the container can connect to it. APP_UID no longer
# needs to match a specific host user, since the container never touches
# tmux or the filesystem directly - only the agent socket.
APP_UID=1000
APP_GID=1000

# --- Host agent socket ---
# Must point at the real socket file created by host-agent/install.sh,
# normally $XDG_RUNTIME_DIR/sessioneer-agent.sock (i.e. /run/user/<uid>/sessioneer-agent.sock).
# The host agent MUST be installed and running before `docker compose up`,
# see README.md.
SESSIONEER_AGENT_SOCKET_HOST=/run/user/1000/sessioneer-agent.sock

# --- Network binding ---
# There is no login for this app - the network binding IS the access
# control. Set this to the server's actual LAN IP (e.g. 192.168.1.50),
# never 0.0.0.0. Leave as 127.0.0.1 if you only intend to reach it via
# SSH tunnel or from the host itself.
BIND_ADDR=127.0.0.1
APP_PORT=8091

# Hostnames the app answers to, besides localhost, 127.0.0.1, ::1 and
# BIND_ADDR (comma-separated, no ports). Add the name you browse to if it's
# anything else, e.g. a reverse-proxy hostname. Requests for any other Host
# get a 421, which is what stops a DNS-rebinding page from reaching the app.
# ALLOWED_HOSTS=sessioneer.example.lan
